---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import ImageSlot from '../components/ImageSlot.astro';
import Table from '../components/Table.astro';
import NextPage from '../components/NextPage.astro';
import PageNav from '../components/PageNav.astro';
import { criaturas, slugify } from '../data/canon.js';

const c = criaturas;
const abas = [['bestiario', 'Bestiário'], ['patrocinadoras', 'Patrocinadoras'], ['entidades', 'Entidades'], ['domacao', 'Domação'], ['assimilacao', 'Assimilação'], ['familiar', 'Familiar das Bruxas']];
// Fichas completas: um .md por criatura em src/data/criaturas (só a parte que os jogadores podem ler).
const fichas = import.meta.glob('../data/criaturas/*.md', { eager: true });
const fichaDe = (slug) => slug && fichas[`../data/criaturas/${slug}.md`]?.Content;
// Rank S nunca passou pelo filtro rupestre: ninguém pintou essas criaturas.
const pintada = (b) => !b.rank.includes('S');
---
<Base title="Criaturas" slug="criaturas" description="Bestiário de Diamond, as Patrocinadoras, as Entidades, como domar uma criatura, a Assimilação e o Familiar das Bruxas.">
  <PageHero
    slug="criaturas"
    title="As <em>Criaturas</em>"
    lead="O que sobrou de vivo em Diamond fugiu para as bordas ou bebeu mana demais. Algumas dessas coisas aceitam um dono."
    intro={c.texto}
    image="criaturas/capa"
    imageLabel="Uma besta de cristal nas jazidas"
  />

  <PageNav items={abas} />

  <section class="sec" id="bestiario">
    <div class="wrap">
      <SectionHead num="01" label="Bestiário" title="Cinco tipos, <em>um Rank</em> cada." lead="O Rank de uma criatura é o mesmo das missões: diz o perigo dela e o Estágio que o personagem precisa para tentar domá-la." />
      <div class="cols-4 tipos5">
        {c.tipos.map(([n, d, r]) => (
          <article class="card" data-reveal>
            <span class="chip chip--blood">Rank {r}</span>
            <h3 class="t-h3" style="margin-top:16px">{n}</h3>
            <p class="t-small" style="margin-top:10px">{d}</p>
          </article>
        ))}
      </div>

      <div class="beasts">
        {c.bestiario.map((b) => {
          const Ficha = fichaDe(b.ficha);
          return (
          <article class:list={['beast', b.secreto && 'beast--secreto']} data-reveal>
            <div class="beast__media">
              <ImageSlot src={`criaturas/${b.img ?? slugify(b.nome)}`} label={b.nome} ratio="4 / 3" class={pintada(b) ? 'slot--rupestre' : 'slot--lenda'} />
              <span class:list={['beast__rank', b.rank.length > 1 && 'beast__rank--wide']}>{b.rank}</span>
              {b.secreto && <span class="beast__secreto">Registro incompleto</span>}
            </div>
            <div class="beast__body">
              <h3 class="t-h3">{b.nome}</h3>
              <p class="beast__sci"><i>{b.cientifico}</i></p>
              <dl class="kv" style="margin-top:14px">
                <dt>Tipo</dt><dd>{b.tipo}</dd>
                <dt>Onde</dt><dd>{b.onde}</dd>
                <dt>Físico</dt><dd>{b.fisico}</dd>
              </dl>
              <p class="t-small beast__nat">{b.natural}</p>
              {Ficha && <button type="button" class="beast__open" data-ficha-open={b.ficha}>{b.secreto ? 'Ler o que se sabe' : 'Ler a ficha completa'}</button>}
            </div>
            {Ficha && (
              <dialog class="ficha" id={`ficha-${b.ficha}`} data-lenis-prevent aria-label={`Ficha: ${b.nome}`}>
                <div class="ficha__in">
                  <header class="ficha__head">
                    <span class:list={['beast__rank', 'ficha__rank', b.rank.length > 1 && 'beast__rank--wide']}>{b.rank}</span>
                    <div>
                      <p class="ficha__eyebrow">{b.tipo} · Rank {b.rank}{b.secreto ? ' · Registro incompleto' : ''}</p>
                      <h2 class="ficha__nome">{b.nome}</h2>
                      <p class="beast__sci"><i>{b.cientifico}</i></p>
                    </div>
                    <button type="button" class="ficha__close" data-ficha-close aria-label="Fechar">×</button>
                  </header>
                  {b.galeria && (
                    <div class="ficha__galeria">
                      {b.galeria.map(([img, nome]) => (
                        <figure><ImageSlot src={`criaturas/${img}`} label={nome} ratio="4 / 3" class="slot--rupestre" parallax={false} /><figcaption>{nome}</figcaption></figure>
                      ))}
                    </div>
                  )}
                  <div class="ficha__texto"><Ficha /></div>
                  {b.secreto && <p class="ficha__fim">O resto desta ficha não está escrito em lugar nenhum. Quem quiser saber como ele luta vai ter que descobrir em jogo.</p>}
                </div>
              </dialog>
            )}
          </article>
          );
        })}
      </div>
      <p class="t-small" style="margin-top:16px" data-reveal>{c.rupestre} O bestiário cresce com os eventos; os narradores podem criar criaturas novas seguindo estes Ranks.</p>
    </div>
  </section>

  <section class="sec sec--line patronas" id="patrocinadoras">
    <div class="wrap">
      <SectionHead num="02" label="Patrocinadoras" title="Três coisas que <em>não estão</em> na parede." lead={c.patrocinadoras.texto} />
      <div class="cols-3">
        {c.patrocinadoras.lista.map((p) => (
          <article class="patrona" data-reveal>
            <div class="patrona__media">
              <ImageSlot src={`criaturas/${p.img}`} label={p.nome} ratio="1 / 1" />
              <span class="patrona__tag">Patrocinadora</span>
            </div>
            <div class="patrona__body">
              <h3 class="patrona__nome">{p.nome}</h3>
              <p class="patrona__epiteto">{p.epiteto}</p>
              <p class="t-small" style="margin-top:12px">{p.aparencia}</p>
              <dl class="kv" style="margin-top:16px">
                <dt>Domínio</dt><dd>{p.dominio}</dd>
                <dt>Patrocínio</dt><dd>{p.patrocinio}</dd>
                <dt>Preço</dt><dd>{p.preco}</dd>
              </dl>
            </div>
          </article>
        ))}
      </div>
      <dl class="gifts" style="margin-top:clamp(40px,5vw,72px)">
        {c.patrocinadoras.regras.map(([n, d]) => <div data-reveal><dt>{n}</dt><dd>{d}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="sec sec--line entidades" id="entidades">
    <div class="wrap">
      <SectionHead num="03" label="Entidades" title="Não se caça. <em>Se pede.</em>" lead={c.entidades.texto} />
      <div class="ents">
        {c.entidades.lista.map((e) => (
          <article class="ent" data-reveal>
            <div class="ent__media">
              <ImageSlot src={`criaturas/${e.img}`} label={e.nome} ratio="4 / 5" />
              <span class="patrona__tag">{e.natureza}</span>
            </div>
            <div class="ent__body">
              <h3 class="patrona__nome">{e.nome}</h3>
              <p class="patrona__epiteto">{e.titulo} · {e.alcunha}</p>
              <p class="ent__lore">{e.lore}</p>
              <dl class="kv" style="margin-top:18px">
                <dt>Como funciona</dt><dd>{e.funciona}</dd>
              </dl>
            </div>
          </article>
        ))}
      </div>
      <p class="t-small" style="margin-top:16px" data-reveal>{c.entidades.aviso}</p>
    </div>
  </section>

  <section class="sec sec--line sec--raise" id="domacao">
    <div class="wrap">
      <SectionHead num="04" label="Domação" title="Ninguém compra <em>lealdade</em>." lead="Domar não depende de sorte. Depende de cenas escritas, do Estágio e da mana que o personagem aceita gastar." />
      <ol class="flow">
        {c.domacao.map(([t, d], i) => (
          <li data-reveal>
            <span class="flow__n">0{i + 1}</span>
            <h3 class="t-h3">{t}</h3>
            <p class="t-small">{d}</p>
          </li>
        ))}
      </ol>

      <div class="grid" style="margin-top:clamp(48px,6vw,90px);align-items:start;row-gap:40px">
        <div class="c-1-6 stack" style="--s:1.2rem">
          <span class="eyebrow" data-reveal><b>A</b>Cenas de Confiança por Rank</span>
          <Table head={['Rank', 'Cenas', 'Estágio mínimo']} rows={c.cenas} />
          <p class="t-small" data-reveal>Cada cena precisa de pelo menos 500 caracteres com a criatura. Na Subjugação, as cenas são trocadas pelo confronto.</p>
        </div>
        <div class="c-7-12 stack" style="--s:1.2rem">
          <span class="eyebrow" data-reveal><b>B</b>Vínculo</span>
          <ol class="ladder">
            {c.vinculo.map(([t, d], i) => <li data-reveal><b>{['I', 'II', 'III', 'IV'][i]}</b><h4>{t}</h4><p>{d}</p></li>)}
          </ol>
          <p class="t-body" data-reveal>{c.limite}</p>
        </div>
      </div>

      <dl class="gifts" style="margin-top:clamp(40px,5vw,72px)">
        {c.regras.map(([n, d]) => <div data-reveal><dt>{n}</dt><dd>{d}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="sec sec--line" id="assimilacao">
    <div class="wrap">
      <SectionHead num="05" label="Assimilação" title="Dois corpos, <em>uma mana</em>." lead={c.assimilacao.texto} />
      <div class="grid" style="align-items:start;row-gap:32px">
        <div class="c-1-5">
          <ImageSlot src="criaturas/assimilacao" label="Um cavaleiro com o pelo e os olhos do Lobo Olho-de-Brasa" ratio="4 / 5" />
        </div>
        <div class="c-6-12 cols-2">
          {c.assimilacao.graus.map((g) => (
            <article class="card" data-reveal>
              <h3 class="t-h3">{g.nome}</h3>
              <dl class="kv" style="margin-top:16px">
                <dt>Requisito</dt><dd>{g.req}</dd>
                <dt>Custo</dt><dd>{g.custo}</dd>
                <dt>Duração</dt><dd>{g.duracao}</dd>
              </dl>
              <ul class="ticks">{g.efeitos.map((e) => <li>{e}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
      <dl class="gifts" style="margin-top:clamp(40px,5vw,72px)">
        {c.assimilacao.custos.map(([n, d]) => <div data-reveal><dt>{n}</dt><dd>{d}</dd></div>)}
      </dl>
      <p class="t-body" style="margin-top:20px" data-reveal>{c.assimilacao.treino}</p>
    </div>
  </section>

  <section class="sec sec--line chap--paper" id="familiar">
    <div class="wrap">
      <SectionHead num="06" label="Familiar das Bruxas" title="A Bruxa não doma. <em>Ela pactua.</em>" lead={c.familiar.texto} />
      <div class="grid" style="align-items:start;row-gap:32px">
        <div class="c-1-5 stack" style="--s:1.2rem">
          <ImageSlot src="criaturas/familiar" label="Uma Bruxa e o seu familiar" ratio="4 / 5" />
        </div>
        <div class="c-6-12">
          <dl class="gifts" style="margin-top:0">
            {c.familiar.regras.map(([n, d]) => <div data-reveal><dt>{n}</dt><dd>{d}</dd></div>)}
          </dl>
        </div>
      </div>
      <div class="cols-3" style="margin-top:clamp(40px,5vw,72px)">
        {c.familiar.marcos.map(([n, d]) => (
          <article class="card" data-reveal>
            <span class="chip chip--violet">Marco</span>
            <h3 class="t-h3" style="margin-top:16px">{n}</h3>
            <p class="t-small" style="margin-top:10px">{d}</p>
          </article>
        ))}
      </div>
      <div class="btns" style="margin-top:32px" data-reveal><a class="btn" href="/racas/">Ver as Bruxas em Raças</a></div>
    </div>
  </section>

  <NextPage slug="criaturas" />

  <script>
    // Fichas completas do bestiário: abre o <dialog> e para a rolagem suave enquanto ele está aberto.
    document.querySelectorAll('[data-ficha-open]').forEach((b) => {
      b.addEventListener('click', () => {
        const d = document.getElementById(`ficha-${b.dataset.fichaOpen}`);
        if (!d) return;
        d.showModal();
        window.__lenis?.stop();
        document.documentElement.classList.add('ficha-aberta');
      });
    });
    document.querySelectorAll('dialog.ficha').forEach((d) => {
      d.addEventListener('close', () => { window.__lenis?.start(); document.documentElement.classList.remove('ficha-aberta'); });
      d.addEventListener('click', (ev) => { if (ev.target === d) d.close(); });
      d.querySelector('[data-ficha-close]')?.addEventListener('click', () => d.close());
    });
  </script>
</Base>
