---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Gem from '../components/Gem.astro';
import Aviso from '../components/portal/Aviso.astro';
import { lerSessao } from '../lib/sessao.js';
import { carregarFicha, imagemUrl } from '../lib/ficha.js';
import { classificacoes, romanos, slugify, ranks } from '../data/canon.js';
import { arvorePorClasse, migrarIds } from '../data/arvores.js';
import fs from 'node:fs';
import path from 'node:path';
import '../styles/ficha.css';
export const prerender = false;

const sessao = lerSessao(Astro.cookies);
const { estado, ficha: f, aviso } = await carregarFicha(sessao);
Astro.response.headers.set('cache-control', 'private, no-store');

const fmt = new Intl.NumberFormat('pt-BR');
const exemplo = estado !== 'ok';
// a ficha de exemplo usa um recorte da casa; a real usa o PNG que o bot guardou
const img = imagemUrl(f.imagem) ?? (exemplo ? '/img/ficha/exemplo.png' : null);
const cor = /^#[0-9a-f]{6}$/i.test(f.cor ?? '') ? f.cor : '#ff3b2e';
const brasao = fs.existsSync(path.join(process.cwd(), 'public/img/brasoes', `${slugify(f.familia)}.svg`)) ? `/img/brasoes/${slugify(f.familia)}.svg` : null;
const arvore = arvorePorClasse(f.classeMago);
const trilhaNos = arvore ? migrarIds(arvore, f.trilha.nos).map((id) => arvore.nos.find((n) => n.id === id)).filter(Boolean) : [];

const NAIPE = { Clover: '♣', Spades: '♠', Heart: '♥', Diamond: '◆' };
const naipe = NAIPE[f.origem] ?? '✦';
const ROM = ['', 'I', 'II', 'III', 'IV'];

// ---------- Ascensão: o que falta e como conseguir (a meta fica sempre à vista)
const prox = f.proximo;
const reqs = prox ? [
  { nome: 'Pontos de Estágio', tem: f.pe, precisa: prox.pe, un: '', k: '点' },
  prox.controle ? { nome: 'Controle', tem: f.controle, precisa: prox.controle, un: '%', k: '御' } : null,
  prox.cristais.branco ? { nome: 'Cristais Brancos', tem: f.moedas.cristais.branco, precisa: prox.cristais.branco, un: '', gema: 'branco', k: '白' } : null,
  prox.cristais.negro ? { nome: 'Cristais Negros', tem: f.moedas.cristais.negro, precisa: prox.cristais.negro, un: '', gema: 'negro', k: '黒' } : null,
  prox.cristais.dourado ? { nome: 'Cristais Dourados', tem: f.moedas.cristais.dourado, precisa: prox.cristais.dourado, un: '', gema: 'dourado', k: '金' } : null,
].filter(Boolean) : [];
const pct = (a, b) => Math.max(0, Math.min(100, b ? (a / b) * 100 : 0));
const total = reqs.length ? Math.round(reqs.reduce((s, r) => s + pct(r.tem, r.precisa), 0) / reqs.length) : 100;
const pronto = prox && reqs.every((r) => r.tem >= r.precisa);

// caminhos concretos, tirados da própria ficha e do Cânone
const caminhos = [];
for (const a of f.fisicos) {
  if (a.treino.precisa && a.indice < a.teto) caminhos.push({ k: '体', t: `Treino de ${a.nome}`, d: `${a.treino.feitos} de ${a.treino.precisa} treinos para ${classificacoes[a.indice + 1]?.nome}. Subir dá 1 PE.`, p: pct(a.treino.feitos, a.treino.precisa), href: '/atributos/' });
}
if (prox?.controle && f.controle < prox.controle) caminhos.push({ k: '御', t: 'Treino de Controle', d: `+1% por treino (+2% em Zona de Forte Mana). A cada 10% você ganha 1 PE.`, href: '/mana/' });
const rankCristal = ranks.filter((r) => r.cristais && r.cristais !== '—');
if (prox && (prox.cristais.branco > f.moedas.cristais.branco)) caminhos.push({ k: '晶', t: 'Missões de Rank C ou B', d: `${rankCristal.filter((r) => /Branco/.test(r.cristais)).map((r) => `Rank ${r.r}: ${r.cristais}`).join(' · ')}.`, href: '/missoes/' });
if (prox && (prox.cristais.negro > f.moedas.cristais.negro)) caminhos.push({ k: '晶', t: 'Missões de Rank A', d: 'Cada Rank A paga 1 Cristal Negro.', href: '/missoes/' });
if (!caminhos.length) caminhos.push({ k: '道', t: 'Treinos e missões', d: 'Treinos sobem atributos (e dão PE); missões pagam Méritos, Yuls e Cristais.', href: '/progressao/' });

const fer = f.ferimentos ?? { pior: 0, desnutrido: false, casas: [1, 1, 1, 2, 2, 3, 4].map((grau) => ({ grau, ocupada: false })) };
const ferTxt = fer.pior ? `${['', 'I Leve', 'II Moderado', 'III Grave', 'IV Crítico'][fer.pior]}${fer.desnutrido ? ' · Desnutrido' : ''}` : 'Ileso';
const cristaisTotal = f.moedas.cristais.branco + f.moedas.cristais.negro + f.moedas.cristais.dourado;
const vagas = (n, max) => `${n} de ${max}`;
const descr = (a) => `${classificacoes[a.indice]?.nome}: ${a.nome === 'Velocidade' ? `${classificacoes[a.indice]?.vel} km/h` : a.nome === 'Força' ? `quebra ${classificacoes[a.indice]?.forca.toLowerCase()}` : `aguenta ${classificacoes[a.indice]?.resistencia.toLowerCase()}`}.`;
// ---------- página dupla
const merito = Math.max(f.moedas.antimeritos, f.moedas.meritos);
const fis = (n) => f.fisicos.find((a) => a.nome === n) ?? { nome: n, indice: 0, teto: 0, acrescimos: 0, treino: { feitos: 0, precisa: null } };
// radar de 6 eixos: corpo na metade de cima, mana na de baixo (Força no topo, sentido horário)
const cls = (a) => classificacoes[a.indice] ?? classificacoes[0];
const eixos = [
  { n: 'Força', a: fis('Força'), g: 'corpo' }, { n: 'Velocidade', a: fis('Velocidade'), g: 'corpo' }, { n: 'Controle', g: 'mana' },
  { n: 'Reserva', g: 'mana' }, { n: 'Poder', g: 'mana' }, { n: 'Resistência', a: fis('Resistência'), g: 'corpo' },
].map((e) => e.a ? { ...e, longo: e.n, v: (e.a.indice + 1) / 8, r: cls(e.a).nome,
    d: e.n === 'Força' ? `Quebra ${cls(e.a).forca.toLowerCase()}.` : e.n === 'Velocidade' ? `Corre a ${cls(e.a).vel} km/h.` : `Aguenta ${cls(e.a).resistencia.toLowerCase()}.` }
  : e.n === 'Controle' ? { ...e, longo: 'Controle', v: Math.max(0.05, f.controle / 100), r: `${f.controle}%`, d: 'Precisão com a mana: mais Controle, feitiço mais barato.' }
  : e.n === 'Reserva' ? { ...e, longo: 'Reserva Mágica', v: f.reserva / 10, r: `${romanos[f.reserva - 1]} de X`, d: `${fmt.format(f.mana.max)} de Mana no tanque.` }
  : { ...e, longo: 'Poder Mágico', v: f.poder / 6, r: `${romanos[f.poder - 1]} de VI`, d: 'A força de cada feitiço que você lança.' });
const lista = [...eixos.filter((e) => e.g === 'corpo').sort((x, y) => ['Força', 'Resistência', 'Velocidade'].indexOf(x.n) - ['Força', 'Resistência', 'Velocidade'].indexOf(y.n)),
  ...eixos.filter((e) => e.g === 'mana').sort((x, y) => ['Poder', 'Reserva', 'Controle'].indexOf(x.n) - ['Poder', 'Reserva', 'Controle'].indexOf(y.n))];
const RC = 150, RR = 108;
const VB = { x: -24, y: 10, w: 348, h: 280 };
const P = (i, k) => { const a = ((-90 + i * 60) * Math.PI) / 180; return [+(RC + Math.cos(a) * RR * k).toFixed(1), +(RC + Math.sin(a) * RR * k).toFixed(1)]; };
const poli = (k) => eixos.map((_, i) => P(i, k).join(',')).join(' ');
const forma = eixos.map((e, i) => P(i, e.v).join(',')).join(' ');
// linhas de velocidade do mangá, sempre as mesmas (semente fixa)
let semente = 11;
const rnd = () => (semente = (semente * 16807) % 2147483647) / 2147483647;
const linhas = Array.from({ length: 84 }, (_, i) => {
  const a = (i / 84) * Math.PI * 2 + rnd() * 0.04, da = 0.004 + rnd() * 0.011, r0 = 30 + rnd() * 24, R = 150, cx = 52, cy = 44;
  const p = (ang, r) => `${(cx + Math.cos(ang) * r).toFixed(1)},${(cy + Math.sin(ang) * r).toFixed(1)}`;
  return `${p(a, r0)} ${p(a - da, R)} ${p(a + da, R)}`;
});
---
<Base title="Ficha" slug="ficha" aba="ficha" description="A ficha do seu Marcado como uma página dupla de mangá: poder, perfil, Grimório, Ascensão e história.">
  <div class="fx" style={`--c:${cor}`} data-fx>
    <Aviso estado={exemplo ? estado : null} aviso={aviso} logado={Boolean(sessao)} />

    <!-- A PÁGINA DUPLA: à esquerda a estreia do personagem no mangá, à direita o arquivo do Conselho -->
    <article class="fx-ed" aria-label={`Ficha de ${f.nome}`} data-card>
      <div class="fx-pg fx-pg--splash" data-fig>
        <svg class="fx-vel" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice" aria-hidden="true">{linhas.map((p) => <polygon points={p} />)}</svg>
        <svg class="fx-enso" viewBox="0 0 200 200" aria-hidden="true">
          <defs><filter id="fx-pincel" x="-10%" y="-10%" width="120%" height="120%"><feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="4" /><feDisplacementMap in="SourceGraphic" scale="9" /></filter></defs>
          <path d="M100 18a82 82 0 1 1-61 27" pathLength="1" filter="url(#fx-pincel)" />
        </svg>
        <span class="fx-kbig" aria-hidden="true">運命</span>
        <p class="fx-narra"><b aria-hidden="true">{naipe}</b>Morreu em {f.origem ?? 'outra terra'}.<br />Acordou em Diamond.</p>
        <p class="fx-hanko"><b>{f.estagio}º</b><small>Estágio</small></p>
        {img ? <img class="fx-pers" src={img} alt={`Imagem de ${f.nome}`} data-pers /> : <span class="fx-sem">Sem imagem</span>}
        <div class="fx-nomebox">
          <p class="fx-nomebox__k">{f.classeMago}<i>·</i>{f.racasHibrido ? 'Híbrido' : f.raca}</p>
          <h1 class="fx-nome">{f.nome}</h1>
          {f.sobrenome && <p class="fx-sob">{f.sobrenome}</p>}
          {f.epiteto && <p class="fx-ep">“{f.epiteto}”</p>}
        </div>
        <p class="fx-folio">{f.numero ? `— ${f.numero * 2} —` : '— prévia —'}</p>
      </div>

      <div class="fx-pg fx-pg--db">
        <header class="fx-db__hd">
          <div>
            <p class="fx-db__k">Black Destiny · Arquivo do Conselho Mágico</p>
            <p class="fx-db__t">{f.numero ? <>Ficha nº <b>{String(f.numero).padStart(4, '0')}</b></> : 'Ficha de prévia'}</p>
          </div>
          <span class="fx-selo" title={f.numero ? 'Aprovada pelo Conselho Mágico' : 'Ainda não aprovada'}>{f.numero ? '承認' : '見本'}</span>
        </header>

        <div class="fx-db__g">
          <section class="fx-db__poder" aria-labelledby="fx-poder-t">
            <h2 class="fx-db__h" id="fx-poder-t"><span aria-hidden="true">力</span>Poder</h2>
            <div class="fx-radar">
              <svg viewBox={`${VB.x} ${VB.y} ${VB.w} ${VB.h}`} aria-hidden="true">
                <g class="fx-radar__grade">
                  {[0.25, 0.5, 0.75, 1].map((k) => <polygon points={poli(k)} />)}
                  {eixos.map((_, i) => <line x1={RC} y1={RC} x2={P(i, 1)[0]} y2={P(i, 1)[1]} />)}
                </g>
                <line class="fx-radar__meio" x1={RC - RR - 18} y1={RC} x2={RC + RR + 18} y2={RC} />
                <g class="fx-radar__forma"><polygon points={forma} />{eixos.map((e, i) => <circle cx={P(i, e.v)[0]} cy={P(i, e.v)[1]} r="4.5" />)}</g>
              </svg>
              <span class="fx-radar__lado is-corpo" aria-hidden="true">Corpo</span>
              <span class="fx-radar__lado is-mana" aria-hidden="true">Mana</span>
              <ul class="fx-radar__rot">
                {eixos.map((e, i) => {
                  const [x, y] = P(i, 1.2);
                  return <li style={`left:${((x - VB.x) / VB.w) * 100}%;top:${((y - VB.y) / VB.h) * 100}%;--i:${i}`}><small>{e.n}</small></li>;
                })}
              </ul>
            </div>
            <dl class="fx-db__val">
              {lista.map((e, i) => (
                <div class:list={[i === 3 && 'is-mana']} style={`--i:${i}`}>
                  <dt>{e.longo}</dt>
                  <dd><b>{e.r}</b><span>{e.d}</span></dd>
                </div>
              ))}
            </dl>
          </section>

          <section class="fx-db__perfil" aria-label="Perfil">
            <h2 class="fx-db__h"><span aria-hidden="true">籍</span>Perfil</h2>
            <dl>
              <div><dt>Raça</dt><dd>{f.racasHibrido ? `Híbrido de ${f.racasHibrido.join(' e ')}` : f.raca}</dd></div>
              <div><dt>Família</dt><dd>{brasao && <img src={brasao} alt="" />}{f.familia}</dd></div>
              <div><dt>Vida passada</dt><dd>{naipe} {f.origem ?? 'Outra terra'}</dd></div>
              <div><dt>Classe social</dt><dd>{f.classeSocial} · {f.regiao}</dd></div>
              <div><dt>Classe de mago</dt><dd>{f.classeMago}</dd></div>
              <div><dt>{f.milagres.length > 1 ? 'Milagres' : 'Milagre'}</dt><dd>{f.milagres.length ? f.milagres.join(' · ') : 'Nenhum ainda'}</dd></div>
              <div><dt>Patente</dt><dd>{f.patente ?? 'Sem patente'}</dd></div>
              <div><dt>Profissão</dt><dd>{f.profissao ?? 'Nenhuma ainda'}</dd></div>
            </dl>
          </section>

          <section class="fx-db__magia" aria-label="Magia">
            <p class="fx-db__h"><span aria-hidden="true">魔</span>Magia{f.magiaRaridade && <em>{f.magiaRaridade}</em>}</p>
            <p class="fx-db__mg">{f.magia.replace(/^Magia de /, '')}</p>
            <p class="fx-db__sub">Grimório {f.grimorio} · {f.feiticosTotal ? `${f.feiticos.length} de ${f.feiticosTotal} páginas escritas` : `${f.feiticos.length} feitiços`}</p>
          </section>

          <section class="fx-db__vida" aria-label="Mana e Ferimentos">
            <div class="fx-mana" tabindex="0" data-dica="Mana que sobra agora. Feitiços gastam, descanso devolve.">
              <p><span>Mana</span><b><span data-conta={f.mana.atual}>{fmt.format(f.mana.atual)}</span> / {fmt.format(f.mana.max)}</b></p>
              <span class="fx-pincel" style={`--p:${pct(f.mana.atual, f.mana.max)}%`}></span>
            </div>
            <div class="fx-fer" tabindex="0" data-dica="Ferimentos: três leves, dois moderados, um grave e um crítico. Quando um grau enche, o próximo vem.">
              <p><span>Ferimentos</span><b class:list={[fer.pior >= 3 && 'is-mal']}>{ferTxt}</b></p>
              <ol>{fer.casas.map((c, i) => <li class:list={[c.ocupada && 'is-on', i > 0 && fer.casas[i - 1].grau !== c.grau && 'is-grupo']}>{ROM[c.grau]}</li>)}</ol>
            </div>
          </section>
        </div>

        <div class="fx-db__saber">
          {[['Conhecimentos', f.conhecimentos, 6, '/conhecimentos/'], ['Traços', f.tracos, 3, '/milagres/'], ['Técnicas', f.tecnicas, null, '/arvores/?arvore=tecnicas']].map(([t, l, max, href]) => (
            <div>
              <p class="fx-db__h"><a href={href}>{t}</a>{max && <small>{l.length} de {max}</small>}</p>
              <p class="fx-chips">{l.length ? l.map((x, j) => <span style={`--i:${j}`}>{x}</span>) : <span class="is-vazio">Nenhum ainda</span>}</p>
            </div>
          ))}
        </div>

        <footer class="fx-db__pe">
          <p class="fx-moedas">
            <span><i class="fx-ic fx-ic--est" aria-hidden="true"></i><b data-conta={merito}>{merito}</b> {f.moedas.antimeritos > f.moedas.meritos ? 'Antiméritos' : 'Méritos'}</span>
            <span><i class="fx-ic fx-ic--yul" aria-hidden="true"></i><b data-conta={f.moedas.yuls}>{fmt.format(f.moedas.yuls)}</b> Yuls</span>
            <span><i class="fx-ic fx-ic--gema" aria-hidden="true"></i><b>{cristaisTotal}</b> Cristais</span>
          </p>
          <p class="fx-folio">{f.numero ? `— ${f.numero * 2 + 1} —` : '— prévia —'}</p>
        </footer>
      </div>
    </article>

    <!-- ASCENSÃO: a próxima meta -->
    <section class="fx-asc" aria-labelledby="fx-asc-t">
      <div class="fx-asc__selo" style={`--p:${total}`} aria-hidden="true">
        <svg viewBox="0 0 120 120"><circle cx="60" cy="60" r="52" /><circle cx="60" cy="60" r="52" class="is-on" pathLength="100" /></svg>
        <b><span data-conta={total}>{total}</span>%</b>
        <small>{prox ? `rumo ao ${prox.estagio}º` : 'no topo'}</small>
      </div>
      <div class="fx-asc__txt">
        <p class="eyebrow"><b>昇</b>Próxima Ascensão</p>
        <h2 id="fx-asc-t" class="fx-asc__t">{pronto ? <>Pronto para o <em>{prox.estagio}º Estágio</em>.</> : prox ? <>Rumo ao <em>{prox.estagio}º Estágio</em>.</> : <>No <em>1º Estágio</em>. O topo.</>}</h2>
        <ul class="fx-req">
          {reqs.map((r) => (
            <li class:list={[r.tem >= r.precisa && 'is-ok']}>
              <span class="fx-req__k" aria-hidden="true">{r.k}</span>
              <span class="fx-req__n">{r.nome}</span>
              <span class="fx-req__v"><b>{r.tem}{r.un}</b> / {r.precisa}{r.un}</span>
              <span class="fx-req__b" style={`--p:${pct(r.tem, r.precisa)}%`}></span>
            </li>
          ))}
        </ul>
      </div>
      <div class="fx-asc__cam">
        <p class="t-label">Como chegar lá</p>
        <ul>
          {caminhos.slice(0, 4).map((c) => (
            <li><a href={c.href}><span class="fx-cam__k" aria-hidden="true">{c.k}</span><span><b>{c.t}</b><small>{c.d}</small></span>{c.p != null && <span class="fx-cam__p" style={`--p:${c.p}%`}></span>}<Icon name="seta" size={14} /></a></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CAPÍTULOS DA FICHA -->
    <section class="fx-cap">
      <div class="fx-tabs" role="tablist" aria-label="Partes da ficha">
        <button role="tab" aria-selected="true" aria-controls="fc-grimorio" id="tab-grimorio" data-tab="grimorio"><span aria-hidden="true">魔</span>Grimório</button>
        <button role="tab" aria-selected="false" aria-controls="fc-trilha" id="tab-trilha" data-tab="trilha"><span aria-hidden="true">樹</span>Trilha</button>
        <button role="tab" aria-selected="false" aria-controls="fc-bolsa" id="tab-bolsa" data-tab="bolsa"><span aria-hidden="true">袋</span>Bolsa</button>
        <button role="tab" aria-selected="false" aria-controls="fc-pessoal" id="tab-pessoal" data-tab="pessoal"><span aria-hidden="true">魂</span>Pessoal</button>
      </div>

      <div class="fx-pan" id="fc-grimorio" role="tabpanel" aria-labelledby="tab-grimorio">
        <div class="fx-grim">
          <div class="fx-grim__capa"><Gem /><span>Grimório {f.grimorio}</span></div>
          <div>
            <p class="t-label">Magia{f.magiaRaridade && ` · ${f.magiaRaridade}`}</p>
            <p class="fx-grim__m">{f.magia}</p>
            <p class="t-label">{f.milagres.length > 1 ? 'Milagres' : 'Milagre'}</p>
            <p class="fx-grim__mi">{f.milagres.length ? f.milagres.join(' · ') : 'Nenhum ainda. O primeiro vem da linhagem ou do Despertar.'}</p>
          </div>
        </div>
        <ul class="fx-feit">
          {f.feiticos.map((x, i) => {
            const fi = imagemUrl(x.imagem);
            return (
              <li class="fx-feit__c" style={`--i:${i}`}>
                <span class="fx-feit__n">{String(i + 1).padStart(2, '0')}</span>
                <div class="fx-feit__img">{fi ? <img src={fi} alt="" loading="lazy" /> : <span aria-hidden="true">{['火', '盾', '癒', '針', '影', '風', '鎖'][i % 7]}</span>}</div>
                <b>{x.nome}</b>
                <small>{[x.tipo, x.estagio ? `${x.estagio}º Estágio` : null].filter(Boolean).join(' · ')}</small>
              </li>
            );
          })}
          {f.feiticosTotal && Array.from({ length: Math.max(0, f.feiticosTotal - f.feiticos.length) }, () => (
            <li class="fx-feit__c is-vazio"><span class="fx-feit__n">··</span><div class="fx-feit__img"><span aria-hidden="true">空</span></div><b>Página em branco</b><small>Um feitiço novo cabe aqui</small></li>
          ))}
        </ul>
      </div>

      <div class="fx-pan" id="fc-trilha" role="tabpanel" aria-labelledby="tab-trilha" hidden>
        <a class="fx-tri" href="/arvores/" style={arvore ? `--cc:${arvore.cor}` : ''}>
          <span class="fx-tri__k" aria-hidden="true">{arvore?.kanji ?? '樹'}</span>
          <span class="fx-tri__n"><b>{f.trilha.livres}</b><small>{f.trilha.livres === 1 ? 'Ponto de Trilha livre' : 'Pontos de Trilha livres'}</small></span>
          <span class="fx-tri__l">
            <span class="t-label">{f.classeMago} · {f.trilha.gastos} de {f.trilha.pontos} gastos</span>
            <span class="fx-tri__nos">{trilhaNos.length ? trilhaNos.map((n) => <em>{n.nome}</em>) : 'Nenhuma habilidade ainda.'}</span>
          </span>
          <span class="btn btn--solid tr-sm">Abrir a árvore <Icon name="seta" size={14} /></span>
        </a>
      </div>

      <div class="fx-pan" id="fc-bolsa" role="tabpanel" aria-labelledby="tab-bolsa" hidden>
        <ul class="fx-bolsa">
          <li><i class="fx-ic fx-ic--yul" aria-hidden="true"></i><b>{fmt.format(f.moedas.yuls)}</b><span>Yuls</span><small>Compra e vende no reino</small></li>
          <li><i class="fx-ic fx-ic--est" aria-hidden="true"></i><b>{f.moedas.meritos}</b><span>Méritos</span><small>A carreira nos Generais Brilhantes</small></li>
          {f.moedas.antimeritos > 0 && <li><i class="fx-ic fx-ic--est is-negro" aria-hidden="true"></i><b>{f.moedas.antimeritos}</b><span>Antiméritos</span><small>A carreira no Veio Negro</small></li>}
          <li><i class="fx-gema fx-gema--branco" aria-hidden="true"></i><b>{f.moedas.cristais.branco}</b><span>Cristais Brancos</span><small>Ascensão do 7º ao 4º</small></li>
          <li><i class="fx-gema fx-gema--negro" aria-hidden="true"></i><b>{f.moedas.cristais.negro}</b><span>Cristais Negros</span><small>Ascensão do 3º e 2º</small></li>
          <li><i class="fx-gema fx-gema--dourado" aria-hidden="true"></i><b>{f.moedas.cristais.dourado}</b><span>Cristais Dourados</span><small>Ascensão ao 1º</small></li>
        </ul>
        <p class="fx-nota">Cristais de Ascensão são do personagem e só se ganham jogando. Cristais Prismáticos são da conta: <a href="/cristais/">veja o que eles fazem</a>.</p>
      </div>

      <div class="fx-pan" id="fc-pessoal" role="tabpanel" aria-labelledby="tab-pessoal" hidden>
        <div class="fx-hist">
          {[['前世', 'Vida passada', f.historia.vidaPassada], ['転生', 'Renascimento', f.historia.renascimento], ['心', 'Personalidade', f.historia.personalidade]].map(([k, t, v], i) => (
            <article class:list={['fx-hist__q', i === 1 && 'is-papel']}>
              <span class="fx-hist__k" aria-hidden="true">{k}</span>
              <h3>{t}</h3>
              <p>{v || 'Ainda não escrita. Escreva na aba Pessoal da /ficha no Discord.'}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <div class="fx-dica" data-fx-dica hidden aria-hidden="true"></div>
  </div>
</Base>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-fx]');
  if (raiz) {
    const card = raiz.querySelector<HTMLElement>('[data-card]')!;
    const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // entrada: o cartão monta quando aparece (sol, personagem, barras, números)
    const conta = (el: HTMLElement) => {
      const fim = Number(el.dataset.conta);
      if (!Number.isFinite(fim) || reduz) return;
      const fmt = new Intl.NumberFormat('pt-BR');
      const t0 = performance.now();
      const dur = 1100;
      const passo = (t: number) => {
        const k = Math.min(1, (t - t0) / dur);
        el.textContent = fmt.format(Math.round(fim * (1 - Math.pow(1 - k, 3))));
        if (k < 1) requestAnimationFrame(passo);
      };
      requestAnimationFrame(passo);
    };
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      const el = e.target as HTMLElement;
      el.classList.add('is-in');
      el.querySelectorAll<HTMLElement>('[data-conta]').forEach(conta);
      io.unobserve(el);
    }), { threshold: 0.2 });
    [card, ...raiz.querySelectorAll<HTMLElement>('.fx-asc, .fx-cap')].forEach((el) => io.observe(el));

    // paralaxe: o personagem e o sol andam em sentidos opostos
    const fig = raiz.querySelector<HTMLElement>('[data-fig]');
    if (fig && !reduz && matchMedia('(hover: hover)').matches) {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
        fig.style.setProperty('--mx', x.toFixed(3)); fig.style.setProperty('--my', y.toFixed(3));
      });
      card.addEventListener('pointerleave', () => { fig.style.setProperty('--mx', '0'); fig.style.setProperty('--my', '0'); });
    }

    // dicas: cada número explica o que é
    const dica = raiz.querySelector<HTMLElement>('[data-fx-dica]')!;
    const mostra = (el: HTMLElement | null) => {
      if (!el) { dica.hidden = true; return; }
      dica.textContent = el.dataset.dica!;
      const r = el.getBoundingClientRect();
      dica.hidden = false;
      const w = dica.offsetWidth;
      dica.style.left = `${Math.max(12, Math.min(innerWidth - w - 12, r.left + r.width / 2 - w / 2))}px`;
      dica.style.top = `${r.top + scrollY - dica.offsetHeight - 10}px`;
    };
    raiz.addEventListener('pointerover', (e) => { const el = (e.target as Element).closest<HTMLElement>('[data-dica]'); if (el) mostra(el); });
    raiz.addEventListener('pointerout', (e) => { const to = (e as PointerEvent).relatedTarget as Element | null; if (!to?.closest('[data-dica]')) mostra(null); });
    raiz.addEventListener('focusin', (e) => mostra((e.target as Element).closest<HTMLElement>('[data-dica]')));
    raiz.addEventListener('focusout', () => mostra(null));

    // abas
    const tabs = Array.from(raiz.querySelectorAll<HTMLButtonElement>('.fx-tabs [data-tab]'));
    const show = (id: string, foco = false) => {
      tabs.forEach((t) => {
        const on = t.dataset.tab === id;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const p = document.getElementById(`fc-${t.dataset.tab}`);
        if (p) { p.hidden = !on; if (on) { p.classList.remove('is-in'); void p.offsetWidth; p.classList.add('is-in'); } }
        if (on && foco) t.focus();
      });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => { show(t.dataset.tab!); try { history.replaceState(null, '', `#${t.dataset.tab}`); } catch { /* sem histórico */ } });
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (d) show(tabs[(i + d + tabs.length) % tabs.length].dataset.tab!, true);
      });
    });
    const h = location.hash.slice(1);
    show(['grimorio', 'trilha', 'bolsa', 'pessoal'].includes(h) ? h : 'grimorio');
  }
</script>
