---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Cristal from '../components/portal/Cristal.astro';
import { lerSessao } from '../lib/sessao.js';
import { banco } from '../lib/db.js';
import { aprovado, moeda, primeiraCompra, pacotes, selo, presente, loja, nuncaAVenda, regras } from '../data/cristais.js';
import { altar, garantia, inscricao } from '../data/altar.js';
export const prerender = false;

const sessao = lerSessao(Astro.cookies);
Astro.response.headers.set('cache-control', 'private, no-store');
let saldo = null;
if (sessao) {
  try { const db = await banco(); const c = db && (await db.collection('contas').findOne({ userId: sessao.id }, { projection: { cp: 1 } })); saldo = db ? (c?.cp ?? 0) : null; } catch { /* sem saldo */ }
}
const fmt = new Intl.NumberFormat('pt-BR');
const brl = (v) => v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
const grupos = [...new Set(loja.map((i) => i.grupo))];
const kanjiPremio = { moldura: '額', titulo: '名', classe: '魔' };
const pctBonus = (p) => Math.round((p.bonus / p.base) * 100);
const maxBonus = Math.max(...pacotes.map(pctBonus));
const cpPorReal = (cp, r) => Math.round(cp / r);
const seloVezes = Math.round((selo.total / selo.preco) / (pacotes[0].cp / pacotes[0].preco));
// metas da calculadora: só itens que existem na loja e no Altar
const metas = [
  { id: 'i10', nome: '10 Inscrições do Altar', cp: inscricao.cp10 },
  { id: 'passe', nome: 'Passe Premium da temporada', cp: loja.find((i) => i.nome.startsWith('Passe'))?.cp ?? 600 },
  { id: 'lend', nome: `Lendário garantido (${garantia.lendario} Inscrições)`, cp: Math.ceil(garantia.lendario / 10) * inscricao.cp10 },
  { id: 'atl', nome: 'Ateliê lendário animado', cp: 1200 },
  { id: 'redef', nome: 'Redefinir a trilha', cp: 450 },
  { id: 'classe', nome: 'Classe de Mago à escolha', cp: 900 },
];
---
<Base title="Cristais Prismáticos" slug="cristais" aba="cristais" description="Cristais Prismáticos: a moeda da sua conta no Black Destiny. Pacotes, Selo Mensal, presente para amigos e a loja da conta.">
  <div class="cp">
    <header class="cp-hd wrap">
      <div>
        <span class="eyebrow"><b>晶</b>Moeda da conta · {moeda.sigla}</span>
        <h1 class="cp-hd__t">Cristais <em>Prismáticos</em></h1>
        <p class="t-body">{moeda.texto}</p>
      </div>
      <div class="cp-saldo">
        <span class="hcp__gem cp-saldo__gem" aria-hidden="true"></span>
        <p class="t-label">Seu saldo</p>
        {saldo != null ? <b class="cp-saldo__n">{fmt.format(saldo)} <small>CP</small></b> : sessao ? <b class="cp-saldo__nd">Ainda indisponível</b> : <a class="cp-saldo__in" href="/api/auth/login?volta=/cristais/">Entre para ver</a>}
      </div>
    </header>

    {!aprovado && <p class="cp-aviso wrap" role="status"><b>Proposta</b>Números da proposta de monetização, ainda sem a aprovação final. Nada aqui cobra: a compra pelo Pix abre quando a Staff liberar.</p>}

    <!-- primeira compra -->
    <section class="cp-pc wrap" aria-labelledby="cp-pc">
      <div class="cp-pc__in">
        <div class="cp-pc__txt">
          <span class="cp-pc__selo" aria-hidden="true">初</span>
          <p class="t-label">Uma vez por conta</p>
          <h2 id="cp-pc" class="cp-pc__t">{primeiraCompra.titulo}</h2>
          <p>{primeiraCompra.texto}</p>
          <p class="cp-pc__letra">{primeiraCompra.letra}</p>
        </div>
        <ul class="cp-pc__premios">
          {primeiraCompra.premios.map((p) => (
            <li><span class="cp-pc__k" aria-hidden="true">{kanjiPremio[p.icone]}</span><b>{p.nome}</b><small>{p.texto}</small></li>
          ))}
        </ul>
        <div class="cp-pc__arte" aria-hidden="true"><Cristal tamanho={6} id="pc" /></div>
      </div>
    </section>

    <!-- pacotes -->
    <section class="cp-sec wrap" aria-labelledby="cp-pac">
      <div class="cp-sec__h"><h2 id="cp-pac" class="t-h2">Pacotes</h2><p class="t-body">Pix pelo Mercado Pago, o mesmo carrinho do bot. Do menor ao maior, até {brl(pacotes.at(-1).preco)}.</p></div>
      <ul class="cp-pacs">
        {pacotes.map((p) => (
          <li class:list={['cp-pac', p.destaque && 'cp-pac--dest']}>
            {p.destaque && <span class="cp-pac__tag">{p.destaque}</span>}
            <div class="cp-pac__arte"><Cristal tamanho={p.n} id={`p${p.n}`} /></div>
            <p class="cp-pac__vol t-label">Nº {String(p.n).padStart(2, '0')}</p>
            <h3 class="cp-pac__nome">{p.nome}</h3>
            <p class="cp-pac__cp"><b>{fmt.format(p.cp)}</b> CP</p>
            <p class="cp-pac__bonus">{p.bonus ? <><span>+{fmt.format(p.bonus)}</span> de bônus · {pctBonus(p)}%</> : 'Sem bônus'}</p>
            <span class="cp-pac__barra" style={`--b:${(pctBonus(p) / maxBonus) * 100}%`} aria-hidden="true"></span>
            <p class="cp-pac__vale">≈ {Math.floor(p.cp / inscricao.cp)} {Math.floor(p.cp / inscricao.cp) === 1 ? 'Inscrição' : 'Inscrições'}<small>{cpPorReal(p.cp, p.preco)} CP por real</small></p>
            <button class="cp-pac__btn" type="button" disabled><span>{brl(p.preco)}</span><small>Em breve</small></button>
          </li>
        ))}
      </ul>
    </section>

    <!-- calculadora -->
    <section class="cp-calc wrap" aria-labelledby="cp-calc-t" data-calc data-pacotes={JSON.stringify(pacotes.map((p) => ({ nome: p.nome, cp: p.cp, preco: p.preco })))} data-selo={JSON.stringify(selo)}>
      <div class="cp-calc__l">
        <span class="eyebrow"><b>算</b>Calculadora</span>
        <h2 id="cp-calc-t" class="t-h2">Do que você <em>precisa</em>?</h2>
        <p class="t-body">Marque o que quer pegar. A calculadora soma os CP e acha o jeito mais barato de chegar lá, sem sobrar dinheiro na mesa.</p>
        <ul class="cp-metas">
          {metas.map((m) => <li><label><input type="checkbox" value={m.cp} data-meta={m.id} /><span>{m.nome}</span><em>{fmt.format(m.cp)} CP</em></label></li>)}
        </ul>
      </div>
      <div class="cp-calc__r" aria-live="polite">
        <p class="t-label">Você precisa de</p>
        <p class="cp-calc__total"><b data-total>0</b> CP</p>
        <div class="cp-calc__plano" data-plano><p class="cp-calc__vazio">Marque pelo menos um item.</p></div>
      </div>
    </section>

    <!-- vitrine do Altar -->
    <a class="cp-alt wrap" href="/altar/">
      <span class="cp-alt__img"><img src={altar.destaque.img} alt="" loading="lazy" /></span>
      <span class="cp-alt__txt">
        <span class="t-label">{altar.temporada} · Destaque{altar.proposta ? ' (proposta)' : ''}</span>
        <b>{altar.destaque.nome}</b>
        <span>{altar.destaque.texto}</span>
        <span class="cp-alt__g"><i>Garantido na {garantia.lendario}ª Inscrição</i><i>Sem 50/50</i><i>Chances sempre à vista</i></span>
      </span>
      <span class="btn btn--solid tr-sm">Ver o Altar <Arrow /></span>
    </a>

    <!-- selo e presente -->
    <section class="cp-duo wrap">
      <article class="cp-selo">
        <span class="cp-selo__k" aria-hidden="true">月</span>
        <p class="t-label">Assinatura de 30 dias</p>
        <h2 class="cp-selo__t">{selo.nome}</h2>
        <p class="cp-selo__n"><b>{fmt.format(selo.total)}</b> CP no mês</p>
        <ol class="cp-selo__dias" aria-label={`${selo.agora} CP na hora e ${selo.porDia} por dia`}>
          <li class="is-agora"><b>{selo.agora}</b><small>na hora</small></li>
          {Array.from({ length: 6 }, (_, i) => <li><b>+{selo.porDia}</b><small>dia {i + 1}</small></li>)}
          <li class="is-mais"><b>…</b><small>até o dia {selo.dias}</small></li>
        </ol>
        <p class="cp-selo__vale">{seloVezes}× mais CP por real que a Lasca, se você usar /selo todo dia.</p>
        <p class="t-small">{selo.texto}</p>
        <button class="cp-pac__btn" type="button" disabled><span>{brl(selo.preco)}</span><small>Em breve</small></button>
      </article>
      <article class="cp-pres">
        <span class="cp-selo__k" aria-hidden="true">贈</span>
        <p class="t-label">Para outro membro</p>
        <h2 class="cp-selo__t">{presente.titulo}</h2>
        <p class="t-body">{presente.texto}</p>
        <p class="cp-pres__bilhete"><span>Bilhete</span>“Pela primeira missão que você me tirou do Fosso.”</p>
      </article>
    </section>

    <!-- loja da conta -->
    <section class="cp-sec wrap" aria-labelledby="cp-loja">
      <div class="cp-sec__h"><h2 id="cp-loja" class="t-h2">Loja da <em>conta</em></h2><p class="t-body">Tudo com resultado conhecido. O que tem vaga limitada ou define o topo do poder só se ganha jogando.</p></div>
      <div class="cp-loja">
        {grupos.map((g) => (
          <div class="cp-loja__g">
            <h3 class="t-label">{g}</h3>
            <ul>
              {loja.filter((i) => i.grupo === g).map((i) => (
                <li><span><b>{i.nome}</b>{(i.nota || i.limite) && <small>{[i.nota, i.limite].filter(Boolean).join(' · ')}</small>}</span><em>{fmt.format(i.cp)} <small>CP</small></em></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      {loja.some((i) => i.grupo === 'Giros') && <p class="cp-loja__altar"><a class="btn btn--solid" href="/altar/">Abrir o Altar dos Vestígios <Arrow /></a></p>}
    </section>

    <!-- nunca à venda + regras -->
    <section class="cp-muro">
      <div class="wrap cp-muro__in">
        <div>
          <span class="eyebrow"><b>禁</b>O muro</span>
          <h2 class="t-h2">Nunca à <em>venda</em>.</h2>
          <p class="t-body">Por nenhum caminho pago. Quem não paga chega no mesmo Estágio, no mesmo tempo.</p>
        </div>
        <ul class="cp-muro__l">{nuncaAVenda.map((n) => <li>{n}</li>)}</ul>
        <ul class="cp-muro__r">{regras.map((n) => <li>{n}</li>)}</ul>
      </div>
    </section>
  </div>
</Base>

<script>
  const c = document.querySelector<HTMLElement>('[data-calc]');
  if (c) {
    type P = { nome: string; cp: number; preco: number };
    const P = JSON.parse(c.dataset.pacotes!) as P[];
    const S = JSON.parse(c.dataset.selo!) as { total: number; preco: number };
    const fmt = new Intl.NumberFormat('pt-BR');
    const brl = (v: number) => v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    // o combo mais barato que alcança a meta (até 4 de cada pacote; a lista é pequena)
    function melhor(meta: number) {
      let best: { q: number[]; preco: number; cp: number } | null = null;
      const q = new Array(P.length).fill(0);
      const rec = (i: number, cp: number, preco: number) => {
        if (best && preco >= best.preco) return;
        if (cp >= meta) { best = { q: [...q], preco, cp }; return; }
        if (i === P.length) return;
        for (let n = 0; n <= 4; n++) { q[i] = n; rec(i + 1, cp + n * P[i].cp, preco + n * P[i].preco); }
        q[i] = 0;
      };
      rec(0, 0, 0);
      return best as { q: number[]; preco: number; cp: number } | null;
    }
    const plano = c.querySelector<HTMLElement>('[data-plano]')!;
    const tot = c.querySelector<HTMLElement>('[data-total]')!;
    const roda = () => {
      const meta = [...c.querySelectorAll<HTMLInputElement>('[data-meta]:checked')].reduce((s, i) => s + Number(i.value), 0);
      tot.textContent = fmt.format(meta);
      if (!meta) { plano.innerHTML = '<p class="cp-calc__vazio">Marque pelo menos um item.</p>'; return; }
      const b = melhor(meta);
      if (!b) { plano.innerHTML = '<p class="cp-calc__vazio">Passa do que dá para comprar de uma vez.</p>'; return; }
      const itens = b.q.map((n, i) => (n ? `<li><b>${n}×</b> ${P[i].nome}<span>${brl(n * P[i].preco)}</span></li>` : '')).join('');
      const sobra = b.cp - meta;
      const teto = b.preco > 150 ? '<p class="cp-calc__nota">Passa do teto de R$ 150 por mês: dá para dividir em dois meses.</p>' : '';
      const seloDica = meta <= S.total ? `<p class="cp-calc__nota">Sem pressa? O Selo Mensal (${brl(S.preco)}) junta ${fmt.format(S.total)} CP em 30 dias.</p>` : '';
      plano.innerHTML = `<ul>${itens}</ul><p class="cp-calc__preco"><span>Total</span><b>${brl(b.preco)}</b></p><p class="cp-calc__sobra">${sobra ? `Sobram ${fmt.format(sobra)} CP na conta.` : 'Sem sobra.'}</p>${teto}${seloDica}`;
    };
    c.addEventListener('change', roda);
    roda();
  }
</script>
