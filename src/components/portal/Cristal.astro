---
// Arte dos pacotes: um aglomerado de Cristais Prismáticos que cresce com o tamanho (1 a 6).
const { tamanho = 1, id = 'c' } = Astro.props;
// [x, base, altura, largura, inclinação]
const lascas = [
  [50, 86, 52, 18, 0], [36, 88, 36, 14, -16], [64, 88, 38, 14, 15], [24, 90, 26, 11, -28], [76, 90, 28, 11, 26],
  [44, 92, 22, 10, -6], [58, 92, 24, 10, 8], [14, 92, 18, 8, -38], [86, 92, 18, 8, 36], [50, 94, 14, 9, 0],
];
const qtd = [1, 3, 5, 7, 9, 10][Math.max(0, Math.min(5, tamanho - 1))];
const escala = 0.62 + tamanho * 0.07;
const usa = lascas.slice(0, qtd).sort((a, b) => b[2] - a[2]);
const forma = ([x, b, h, w, r], i) => {
  const t = b - h * escala;
  const m = w * escala / 2;
  return { d: `M${x} ${t} L${x + m} ${t + m * 1.1} L${x + m} ${b - m * 0.4} L${x} ${b} L${x - m} ${b - m * 0.4} L${x - m} ${t + m * 1.1} Z`, face: `M${x} ${t} L${x + m} ${t + m * 1.1} L${x + m} ${b - m * 0.4} L${x} ${b} Z`, r, x, b, i };
};
const fs = usa.map(forma).reverse();
---
<svg class="cp-arte" viewBox="0 0 100 100" aria-hidden="true">
  <defs>
    <linearGradient id={`${id}-p`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#7fd6e3" /><stop offset=".35" stop-color="#b9a4ff" /><stop offset=".65" stop-color="#ff9ec7" /><stop offset="1" stop-color="#ffd27a" />
    </linearGradient>
    <radialGradient id={`${id}-g`} cx=".5" cy=".85" r=".55"><stop offset="0" stop-color="#b9a4ff" stop-opacity=".55" /><stop offset="1" stop-color="#b9a4ff" stop-opacity="0" /></radialGradient>
  </defs>
  <ellipse cx="50" cy="90" rx={20 + tamanho * 4} ry="9" fill={`url(#${id}-g)`} />
  {fs.map((s) => (
    <g transform={`rotate(${s.r} ${s.x} ${s.b})`}>
      <path d={s.d} fill={`url(#${id}-p)`} />
      <path d={s.face} fill="#0b0a10" fill-opacity=".28" />
      <path d={s.d} fill="none" stroke="#fff" stroke-opacity=".55" stroke-width=".5" stroke-linejoin="round" />
    </g>
  ))}
  <g fill="#fff">
    <path d="M78 22l1.2 3 3 1.2-3 1.2-1.2 3-1.2-3-3-1.2 3-1.2z" opacity=".8" />
    <circle cx="22" cy="34" r=".9" opacity=".7" /><circle cx="84" cy="52" r=".7" opacity=".6" />
  </g>
</svg>
