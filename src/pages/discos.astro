---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PageNav from '../components/PageNav.astro';
import SectionHead from '../components/SectionHead.astro';
import ImageSlot from '../components/ImageSlot.astro';
import Table from '../components/Table.astro';
import NextPage from '../components/NextPage.astro';
import { discos as d, slugify } from '../data/canon.js';

const abas = [['regras', 'Engaste'], ['lapidacao', 'Lapidação'], ['catalogo', 'Catálogo']];
---
<Base title="Discos" slug="discos" description="Discos de Engaste: runas gravadas em cristal e engastadas no corpo. Encaixes, Rejeição, Instabilidade e o catálogo de Diamond.">
  <PageHero
    slug="discos"
    title="Os <em>Discos</em>"
    lead="Em Diamond, quem não nasceu com mana compra. Um disco de cristal sob a pele faz uma coisa só, e faz sempre."
    intro={d.texto}
    image="discos/capa"
    imageLabel="Um disco de cristal sendo engastado na nuca"
  />

  <PageNav items={abas} />

  <section class="sec" id="regras">
    <div class="wrap">
      <SectionHead num="01" label="Engaste" title="Quanto cristal <em>um corpo aguenta</em>." lead="Encaixes dizem quantos discos cabem. A Rejeição diz quanto peso o corpo suporta. A Instabilidade diz quando um disco forte vai cobrar." />
      <div class="grid" style="align-items:start;row-gap:32px">
        <div class="c-1-5">
          <ImageSlot src="discos/engaste" label="Cirurgia de Engaste no Lapidário" ratio="4 / 5" />
        </div>
        <div class="c-6-12">
          <dl class="gifts" style="margin-top:0">
            {d.regras.map(([n, t]) => <div data-reveal><dt>{n}</dt><dd>{t}</dd></div>)}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--line sec--raise" id="lapidacao">
    <div class="wrap">
      <SectionHead num="02" label="Lapidação" title="Do <em>bruto</em> ao brilhante." lead="A qualidade do corte muda a Rejeição e o preço. O disco Bruto pesa mais no corpo; o Brilhante só sai da Forja." />
      <Table head={['Grau', 'Onde se consegue', 'Rejeição', 'Preço base']} rows={d.lapidacao} />
    </div>
  </section>

  <section class="sec sec--line" id="catalogo">
    <div class="wrap">
      <SectionHead num="03" label="Catálogo" title="Vinte e três <em>runas</em> de cristal." lead="Nenhum disco dá Acréscimo. Os marcados com Instabilidade são os mais fortes: o efeito colateral acontece quando as marcas chegam ao limite." />
      {d.linhas.map(([linha, sub]) => (
        <div class="disc-line">
          <div class="disc-line__head" data-reveal>
            <h3 class="t-h3">{linha}</h3>
            <p class="t-small">{sub}</p>
          </div>
          <div class="cols-3">
            {d.lista.filter((x) => x.linha === linha).map((x) => (
              <article class:list={['card', 'disc', x.instavel && 'disc--instavel']} id={slugify(x.nome)} data-reveal>
                <div class="chips">
                  <span class="chip chip--mana">{x.onde}</span>
                  <span class="chip">Rejeição {x.rejeicao}</span>
                  {x.instavel && <span class="chip chip--blood">Instável</span>}
                </div>
                <h4 class="t-h3 card__title">{x.nome}</h4>
                <p class="card__text">{x.efeito}</p>
                {x.instavel && <p class="t-small disc__risk"><b>Instabilidade:</b> {x.instavel}</p>}
              </article>
            ))}
          </div>
        </div>
      ))}
      <div class="btns" style="margin-top:32px" data-reveal>
        <a class="btn" href="/mana/#runas">Ver as Técnicas Rúnicas</a>
        <a class="btn" href="/economia/#recursos">Discos em branco nos Recursos</a>
      </div>
    </div>
  </section>

  <NextPage slug="discos" />
</Base>
