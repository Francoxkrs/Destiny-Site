---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import ImageSlot from '../components/ImageSlot.astro';
import NextPage from '../components/NextPage.astro';
import Table from '../components/Table.astro';
import { magias, grimorios, nivelFeitico, tiposFeitico, funcoesDetalhe, funcoesRegras, maestria, slugify } from '../data/canon.js';

const gruposFuncao = [
  { id: 'basica', titulo: 'Básicas', sub: 'Todo Marcado tem', chip: '' },
  { id: 'avancada', titulo: 'Avançadas', sub: 'Vêm de Conhecimentos', chip: 'chip--mana' },
  { id: 'perdida', titulo: 'Perdidas', sub: 'Vêm de Conhecimentos Perdidos', chip: 'chip--gold' },
];

const trio = [
  ['Magia', 'O atributo mágico do personagem: fogo, cristal, sombras. Vem do giro na criação.'],
  ['Grimório', 'O livro que registra os feitiços. O Marcado já renasce com o seu, sorteado na criação, com um diamante na capa.'],
  ['Feitiço', 'Cada técnica escrita no Grimório. Criada pelo jogador e aprovada pelo Conselho Mágico.'],
];
---
<Base title="Magia" slug="magia" description="As magias por raridade, os cinco tipos de Grimório e as regras de feitiço: Estágio, Tipo, Função e Maestria.">
  <PageHero
    slug="magia"
    title="Magia, <em>Grimório</em> e Feitiço"
    lead="A magia vem do giro na criação. Os feitiços, você escreve."
    intro="O Grimório precisa estar aberto para os feitiços funcionarem; ao fechá-lo, todos os feitiços ativos acabam. Longe do usuário além da distância máxima, ele para de funcionar."
    image="magia/capa"
    imageLabel="Um Grimório se abrindo"
  />

  <section class="sec--tight">
    <div class="wrap cols-3">
      {trio.map(([t, d], i) => (
        <div class="stat" data-reveal><p class="t-label t-mana">0{i + 1}</p><h3 class="t-h2" style="margin-top:14px">{t}</h3><p class="t-body" style="margin-top:12px">{d}</p></div>
      ))}
    </div>
  </section>

  <section class="sec sec--line">
    <div class="wrap">
      <SectionHead num="01" label="Magias" title="Cada magia tem <em>vagas</em>." lead="Quando as vagas acabam, a magia sai do giro até uma vaga abrir. Magias Exclusivas só vêm de eventos, sorteios e famílias; a Magia Original é criada junto com o Conselho Mágico." />
      <div data-bars>
        {magias.map((m) => (
          <div class:list={['rarity', `r-${slugify(m.raridade)}`]} data-reveal>
            <div>
              <h3 class="rarity__name">{m.raridade}</h3>
              <div class="rarity__meta">
                <span class="t-label">{m.chance ? `${m.chance}% no giro · ${m.vagas} vagas por magia` : 'Fora do giro · vagas definidas em cada caso'}</span>
                <div class="rarity__chance" style={`--w:${m.chance ? (m.chance / 45) * 100 : 100}%`}><i></i></div>
              </div>
            </div>
            <div class="chips">{m.lista.map((x) => <span class="chip">{x}</span>)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec--line sec--raise">
    <div class="wrap">
      <SectionHead num="02" label="Grimórios" title="Cinco livros. <em>Um diamante na capa.</em>" lead="Na criação, o giro dá 92% de chance de Grimório Comum e 8% de Lendário. Os outros vêm de sorteios, eventos, famílias ou da costura feita por quem domina a ciência." />
      <div class="grims">
        {grimorios.map((g) => (
          <article class="grim" data-reveal>
            <ImageSlot src={`grimorios/${slugify(g.nome)}`} label={`Grimório ${g.nome}`} ratio="3 / 4" />
            <h3 class="t-h3">{g.nome}</h3>
            <p class="t-small">{g.texto}</p>
            <dl class="kv">
              <dt>Iniciais</dt><dd>{g.iniciais}</dd>
              <dt>Por Estágio</dt><dd>{g.ganho}</dd>
              <dt>Máximo</dt><dd>{g.max}</dd>
              <dt>Mana guardada</dt><dd>{g.mana}</dd>
              <dt>Distância</dt><dd>{g.distancia}</dd>
              <dt>Obtenção</dt><dd>{g.obtencao}</dd>
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec--line">
    <div class="wrap">
      <SectionHead num="03" label="Feitiços" title="Escreva. Envie. <em>Domine.</em>" lead="O jogador escreve o feitiço e envia ao Conselho Mágico pelo bot. Todo feitiço tem Nome, Tipo, Função Mágica, Efeito e Duração. O nível e o custo vêm do Estágio em que ele é lançado." />
      <div class="grid" style="align-items:start">
        <div class="c-1-7">
          <article class="spell" data-reveal data-tilt>
            <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap"><span class="t-label t-mana">Exemplo de feitiço</span><span class="t-label">Magia de Cristal</span></div>
            <h3 class="t-h2" style="margin-top:18px">Lança <em>Facetada</em></h3>
            <dl class="spell__grid">
              <div><dt>Lançado no</dt><dd>7º Estágio</dd></div>
              <div><dt>Tipo</dt><dd>Externalizado</dd></div>
              <div><dt>Função</dt><dd>Ataque</dd></div>
              <div><dt>Custo</dt><dd>70 de Mana</dd></div>
            </dl>
            <p class="spell__fx"><b>Efeito:</b> uma lança de cristal disparada em linha reta. Usa a Força da magia com os Acréscimos do Poder Mágico. Na Afinidade certa, como dentro de uma mina, recebe +1 Acréscimo. <b>Duração:</b> instantânea.</p>
          </article>
        </div>
        <div class="c-8-12 stack" style="--s:1.2rem">
          <h3 class="t-h3" data-reveal>O Estágio é o nível</h3>
          <p class="t-body" data-reveal>Não existe Grau. O feitiço vale o Estágio em que é lançado: pode ser o seu ou um abaixo, pagando menos. Com +10 Acréscimos, ele vale como o Estágio seguinte.</p>
          <Table head={['Estágio', 'Alcance', 'Custo']} rows={nivelFeitico.map((x) => [`<b>${x.n}</b>`, `${x.alcance} m`, `${x.custo}`])} numCols={[1, 2]} />
          <div class="btns" data-reveal><a class="btn" href="/estagios/">Tudo sobre os Estágios</a></div>
        </div>
      </div>

      <div class="grid" style="margin-top:clamp(56px,7vw,110px);align-items:start">
        <div class="c-1-6">
          <h3 class="t-h3" data-reveal>Tipos</h3>
          <ol class="steps" style="margin-top:20px">{tiposFeitico.map(([t, d]) => <li data-reveal><div><h4>{t}</h4><p>{d}</p></div></li>)}</ol>
        </div>
        <div class="c-7-12 stack" style="--s:1.6rem">
          <h3 class="t-h3" data-reveal>Maestria <span class="t-mana">0–3</span></h3>
          <p class="t-body" data-reveal>Cada feitiço ganha 1 ponto de Maestria a cada 5 cenas registradas em que foi usado.</p>
          <Table head={['Maestria', 'Efeito']} rows={maestria} />
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--line sec--raise" id="funcoes">
    <div class="wrap">
      <SectionHead num="04" label="Funções Mágicas" title="O que o feitiço <em>pode fazer</em>." lead="A Função diz para que serve o feitiço. As Básicas todo Marcado tem; as outras vêm de Conhecimentos. Abra cada uma para ver os números base, os limites e o que dá para fazer sem ela. Os bônus de Conhecimento somam em cima desses números." />
      <dl class="fn-regras" data-reveal>
        {funcoesRegras.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}
      </dl>
      {gruposFuncao.map((g) => (
        <div class="fn-grupo">
          <p class="t-label fn-grupo__t" data-reveal>{g.titulo} · {g.sub}</p>
          <div class="fn-lista">
            {funcoesDetalhe.filter((f) => f.grupo === g.id).map((f) => (
              <details class="fn" id={`funcao-${slugify(f.nome)}`} data-reveal>
                <summary>
                  <span class:list={['chip', g.chip]}>{f.nome}</span>
                  <span class="fn__libera">{f.libera}</span>
                  <span class="fn__faz">{f.faz}</span>
                </summary>
                <div class="fn__corpo">
                  <div>
                    <h4 class="fn__k">Números base</h4>
                    <ul class="ticks">{f.numeros.map((x) => <li>{x}</li>)}</ul>
                  </div>
                  <div>
                    <h4 class="fn__k">Limites</h4>
                    <ul class="ticks">{f.limites.map((x) => <li>{x}</li>)}</ul>
                  </div>
                  <div class="fn__sem">
                    <h4 class="fn__k">{g.id === 'basica' ? 'Onde ela para' : 'Sem ela'}</h4>
                    <p>{f.sem}</p>
                  </div>
                  {f.conhecimento && (
                    <div>
                      <h4 class="fn__k">Conhecimentos e famílias</h4>
                      <dl class="fn__con">{f.conhecimento.map(([n, b]) => <div><dt>{n}</dt><dd>{b}</dd></div>)}</dl>
                    </div>
                  )}
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}
      <div class="btns" style="margin-top:36px" data-reveal><a class="btn" href="/conhecimentos/">Ver os Conhecimentos</a><a class="btn" href="/ferimentos/">Ferimentos e cura</a></div>
    </div>
  </section>

  <NextPage slug="magia" />
</Base>

<style>
  .fn-regras { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 18px 28px; margin: 0 0 clamp(36px, 5vw, 64px); }
  .fn-regras > div { min-width: 0; border-top: 1px solid var(--line-2); padding-top: 12px; }
  .fn-regras dt { font-family: var(--f-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--mana); }
  .fn-regras dd { margin: 8px 0 0; color: var(--bone-2); font-size: 0.94rem; line-height: 1.55; }
  .fn-grupo { margin-top: clamp(28px, 4vw, 48px); }
  .fn-grupo__t { margin-bottom: 12px; }
  .fn-lista { border-top: 1px solid var(--line); }
  .fn { border-bottom: 1px solid var(--line); }
  .fn summary { display: grid; grid-template-columns: minmax(0, 180px) minmax(0, 1fr) auto; grid-template-areas: 'nome faz mais' 'lib faz mais'; gap: 6px 24px; align-items: start; padding: 18px 2px; cursor: pointer; list-style: none; }
  .fn summary::-webkit-details-marker { display: none; }
  .fn summary::after { content: '+'; grid-area: mais; font-family: var(--f-mono); color: var(--mana); transition: transform 0.3s var(--ease); }
  .fn[open] summary::after { transform: rotate(45deg); }
  .fn summary:focus-visible { outline: 2px solid var(--mana); outline-offset: 2px; }
  .fn summary .chip { grid-area: nome; justify-self: start; }
  .fn__libera { grid-area: lib; font-family: var(--f-mono); font-size: 11px; letter-spacing: 0.06em; color: var(--mute); }
  .fn__faz { grid-area: faz; color: var(--bone); line-height: 1.55; min-width: 0; }
  @media (hover: hover) { .fn summary:hover .fn__faz { color: var(--mana); } }
  .fn__corpo { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 22px 36px; padding: 4px 2px 28px; }
  .fn__corpo > div { min-width: 0; }
  .fn__k { font-family: var(--f-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--mute); margin: 0 0 8px; }
  .fn__corpo .ticks { margin-top: 0; }
  .fn__corpo .ticks li { color: var(--bone-2); font-size: 0.94rem; line-height: 1.55; }
  .fn__sem p { margin: 0; color: var(--bone); font-size: 0.94rem; line-height: 1.55; border-left: 2px solid var(--blood); padding-left: 12px; }
  .fn__con { margin: 0; display: grid; gap: 8px; }
  .fn__con > div { display: grid; grid-template-columns: minmax(0, 150px) minmax(0, 1fr); gap: 12px; font-size: 0.9rem; }
  .fn__con dt { color: var(--bone); font-weight: 600; }
  .fn__con dd { margin: 0; color: var(--bone-2); }
  @media (max-width: 640px) {
    .fn summary { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'nome mais' 'lib lib' 'faz faz'; gap: 6px 12px; }
    .fn__con > div { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
