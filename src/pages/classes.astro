---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import ImageSlot from '../components/ImageSlot.astro';
import NextPage from '../components/NextPage.astro';
import { classesMago, slugify } from '../data/canon.js';
---
<Base title="Classes de Mago" slug="classes" description="Oito estilos de combate, cada um com Conhecimento de classe, passiva e Classe Avançada no 6º Estágio.">
  <PageHero
    slug="classes"
    title="Classes <em>de Mago</em>"
    lead="A Classe de Mago é o estilo de combate do personagem. Ela vem definida no modelo do /criar-personagem e não muda depois, a não ser por evento."
    intro="Cada classe dá um Conhecimento que não ocupa espaço, uma passiva e, no 6º Estágio com Controle Mágico de 20% ou mais, uma Classe Avançada."
    image="classes/capa"
    imageLabel="Os oito estilos de combate"
  />

  <section class="sec">
    <div class="wrap">
      <SectionHead num="01" label="Os oito estilos" title="Como você <em>luta</em>." lead="Passivas e Classes Avançadas seguem a regra dos Acréscimos: nenhuma dá mais de 1 por aplicação." />
      {classesMago.map((c, i) => (
        <article class="mclass">
          <span class="mclass__n">0{i + 1}</span>
          <div class="stack" style="--s:1rem">
            <h3 class="t-h2" data-split>{c.nome}</h3>
            <p class="t-lead" data-reveal>{c.papel}</p>
            <div class="chips" data-reveal><span class="chip chip--mana">{c.conhecimento}</span></div>
          </div>
          <div class="mclass__perks">
            <div class="perk" data-reveal><span class="t-label">Passiva</span><h4>{c.passiva[0]}</h4><p>{c.passiva[1]}</p></div>
            <div class="perk perk--adv" data-reveal><span class="t-label t-gold">Classe Avançada · 6º Estágio</span><h4>{c.avancada[0]}</h4><p>{c.avancada[1]}</p></div>
          </div>
          <div data-reveal><ImageSlot src={`classes/${slugify(c.nome)}`} label={c.nome} ratio="3 / 4" compact /></div>
        </article>
      ))}
    </div>
  </section>

  <section class="sec sec--line sec--raise">
    <div class="wrap grid">
      <div class="c-1-5"><span class="eyebrow" data-reveal><b>02</b>Classes antigas</span></div>
      <div class="c-6-12 stack" style="--s:1rem">
        <p class="t-lead" data-reveal>As famílias antigas citavam outras classes. Elas viraram estas:</p>
        <dl class="kv" data-reveal>
          <dt>Armamentista</dt><dd>Mago de Batalha</dd>
          <dt>Inventor</dt><dd>Mago Artífice</dd>
          <dt>Suporte</dt><dd>Mago Curandeiro</dd>
          <dt>Mago</dt><dd>Mago Arcano</dd>
        </dl>
        <p class="t-body" data-reveal>No /criar-personagem a classe é sorteada entre as oito, com mais chance para a que combina com a família. A exceção é a família Frankenstein, que nunca recebe Mago Artífice.</p>
      </div>
    </div>
  </section>

  <NextPage slug="classes" />
</Base>
