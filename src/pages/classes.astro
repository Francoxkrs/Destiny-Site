---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import ImageSlot from '../components/ImageSlot.astro';
import NextPage from '../components/NextPage.astro';
import { classesMago, trilhaRegras, slugify } from '../data/canon.js';

// Árvores v2 (as mesmas do bot e da página Árvores): Raiz, 3 ramos de 7 nós e 3 Elos.
const jsons = import.meta.glob('../data/trilhas/*.json', { eager: true });
const arvores = Object.values(jsons).map((m) => m.default ?? m).filter((t) => t.classe);
const arvoreDe = (nome) => arvores.find((t) => t.classe === nome);
const grau = { 1: 'Grau I', 2: 'Grau II', 3: 'Grau III', 4: 'Grau IV', 5: 'Ápice' };
---
<Base title="Classes de Mago" slug="classes" description="Nove estilos de combate (o nono só para Corpo Vazio e Antimagia), cada um com Conhecimento de classe, passiva e uma árvore de 24 habilidades onde o mago gasta os Pontos de Trilha que ganha a cada Estágio.">
  <PageHero
    slug="classes"
    title="Classes <em>de Mago</em>"
    lead="A Classe de Mago é o estilo de combate do personagem. Ela vem no modelo do /criar-personagem e só muda pelo /classe, depois de três provas com o mestre da classe."
    intro="Cada classe dá um Conhecimento que não ocupa espaço, uma passiva (a Raiz) e uma árvore com três ramos e três Elos. São 13 pontos até o 1º Estágio para 39 de árvore: dois magos da mesma classe nunca saem iguais."
    image="classes/capa"
    imageLabel="Os estilos de combate"
  />

  <section class="sec" id="trilha">
    <div class="wrap">
      <SectionHead num="01" label="A trilha" title="Treze pontos, <em>trinta e nove de árvore</em>." lead="A passiva é a Raiz. Cada ramo vai do Grau I ao Ápice, os Elos ligam dois ramos, e ninguém pega tudo." />
      <dl class="gifts">
        {trilhaRegras.map(([n, t]) => <div data-reveal><dt>{n}</dt><dd>{t}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="sec sec--line">
    <div class="wrap">
      <SectionHead num="02" label="Os nove estilos" title="Como você <em>luta</em>." lead="O Ápice marcado com ★ é o que antes era a Classe Avançada. O Mago do Vazio, o nono, é só de quem não tem mana: Corpo Vazio ou Antimagia." />
      {classesMago.map((c, i) => (
        <article class="mclass mclass--trilha" id={slugify(c.nome)}>
          <span class="mclass__n">{String(i + 1).padStart(2, '0')}</span>
          <div class="stack" style="--s:1rem">
            <h3 class="t-h2" data-split>{c.nome}</h3>
            <p class="t-lead" data-reveal>{c.papel}</p>
            <div class="chips" data-reveal><span class="chip chip--mana">{c.conhecimento}</span>{c.restrita && <span class="chip">Só para {c.restrita.join(' ou ')}</span>}</div>
            <div class="perk" data-reveal><span class="t-label">Raiz · Passiva</span><h4>{c.passiva[0]}</h4><p>{c.passiva[1]}</p></div>
            <div data-reveal><ImageSlot src={`classes/${slugify(c.nome)}`} label={c.nome} ratio="3 / 4" compact /></div>
          </div>
          {arvoreDe(c.nome) && (() => {
            const t = arvoreDe(c.nome);
            const elos = t.nos.filter((n) => n.elo);
            return (
              <div class="stack" style="--s:14px">
                <div class="ramos">
                  {t.ramos.map((r) => {
                    const nos = t.nos.filter((n) => !n.elo && n.ramo.includes(r.id)).sort((x, y) => x.grau - y.grau);
                    return (
                      <div class="ramo" data-reveal>
                        <p class="ramo__nome t-label">{r.nome}</p>
                        <ol class="ramo__nos">
                          <li class="no"><span class="no__tag">O ramo</span><p>{r.tema}</p><p class="t-small">{nos.filter((n) => n.grau < 5).map((n) => n.nome).join(' · ')}</p></li>
                          {nos.filter((n) => n.grau === 5).map((n) => (
                            <li class="no no--apice">
                              <span class="no__tag">Ápice · {n.estagioMin}º Estágio · {n.custo} PT</span>
                              <h4>{r.estrela === n.id ? '★ ' : ''}{n.nome}</h4>
                              <p>{n.texto}</p>
                            </li>
                          ))}
                        </ol>
                      </div>
                    );
                  })}
                </div>
                <p class="t-small" data-reveal><b>Elos:</b> {elos.map((n) => n.nome).join(' · ')}. <a href={`/arvores/?classe=${t.slug}`}>Ver a árvore inteira e gastar os pontos →</a></p>
              </div>
            );
          })()}
        </article>
      ))}
    </div>
  </section>

  <section class="sec sec--line sec--raise">
    <div class="wrap grid">
      <div class="c-1-5"><span class="eyebrow" data-reveal><b>03</b>Classe na criação</span></div>
      <div class="c-6-12 stack" style="--s:1rem">
        <p class="t-body" data-reveal>No /criar-personagem a classe é sorteada entre as oito comuns, com mais chance para a que combina com a família. A exceção é a família Frankenstein, que nunca recebe Mago Artífice. O Mago do Vazio nunca sai no sorteio: quem ganha o Corpo Vazio ou a Antimagia aprende com o Mestre do Vazio, nos Planaltos mortos, pelo /classe.</p>
      </div>
    </div>
  </section>

  <NextPage slug="classes" />
</Base>
