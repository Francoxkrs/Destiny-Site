---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import ImageSlot from '../components/ImageSlot.astro';
import NextPage from '../components/NextPage.astro';
import Gem from '../components/Gem.astro';
import { ranks, missaoFluxo, missaoRegras } from '../data/canon.js';

const fmt = (n) => n.toLocaleString('pt-BR');
---
<Base title="Missões" slug="missoes" description="Como as missões funcionam no bot, os Ranks de F a S, recompensas, limite diário e interferência.">
  <PageHero
    slug="missoes"
    title="Missões"
    lead="Missões são objetivos narrados que dão Méritos, Antiméritos, Yuls e Cristais. Tudo passa pelo bot."
    intro="Ele libera o quadro de missões, recebe as solicitações, registra o resultado e entrega as recompensas."
    image="missoes/capa"
    imageLabel="Uma escolta na Fronteira Cinzenta"
  />

  <section class="sec">
    <div class="wrap">
      <SectionHead num="01" label="Como funciona no bot" title="Do quadro <em>ao histórico</em>." />
      <ol class="flow">
        {missaoFluxo.map(([t, d, cmd], i) => (
          <li data-reveal>
            <span class="flow__n">0{i + 1}</span>
            <h3 class="t-h3">{t}</h3>
            <p class="t-small">{d}</p>
            <code class="flow__cmd">{cmd}</code>
          </li>
        ))}
      </ol>
      <p class="t-small" style="margin-top:16px" data-reveal>Os nomes dos comandos são ilustrativos; os definitivos saem junto com o bot.</p>

      <div class="grid" style="margin-top:clamp(56px,7vw,110px);align-items:center">
        <div class="c-1-5 stack" style="--s:1.2rem">
          <span class="eyebrow" data-reveal><b>Prévia</b>O quadro do dia</span>
          <p class="t-lead" data-reveal>O quadro se renova todo dia, separado para Generais Brilhantes e Veio Negro.</p>
          <p class="t-body" data-reveal>Missões dos Generais dão Méritos (Estrelas Douradas); as do Veio Negro dão Antiméritos (Estrelas Negras). Os dois servem para subir de patente.</p>
        </div>
        <div class="c-6-12" data-reveal>
          <div class="discord" aria-label="Exemplo do quadro de missões no Discord">
            <div class="discord__bar"><i></i><i></i><i></i><span>#quadro-de-missões</span></div>
            <div class="discord__msg">
              <span class="discord__av"><Gem /></span>
              <div>
                <p class="discord__name">Black Destiny <span>BOT</span></p>
                <div class="discord__embed">
                  <h5>◆ Quadro de Missões · Generais Brilhantes</h5>
                  <div class="discord__row"><span><b>[F]</b> Escoltar uma carga de grãos até os Veios</span><span>100 Yuls · 1 Mérito</span></div>
                  <div class="discord__row"><span><b>[E]</b> Encontrar um Anão fugido dos laboratórios</span><span>250 Yuls · 2 Méritos</span></div>
                  <div class="discord__row"><span><b>[D]</b> Desmontar um ponto de contrabando no Fosso</span><span>500 Yuls · 3 Méritos</span></div>
                  <div class="discord__row"><span><b>[C]</b> Reconhecimento além da Fronteira Cinzenta</span><span>1.000 Yuls · 5 Méritos · 1 Branco</span></div>
                  <div class="discord__btns"><span class="p">Pegar missão</span><span>Pedir personalizada</span><span>Meu histórico</span></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--line sec--raise">
    <div class="wrap">
      <SectionHead num="02" label="Ranks" title="De F a S, <em>do dia a dia ao fim do mundo</em>." lead={missaoRegras.exemplos} />
      <div class="ranks">
        {ranks.map((r) => (
          <article class="rank" data-reveal>
            <span class="rank__r">{r.r}</span>
            <dl>
              <div><dt>Perigo</dt><dd>{r.perigo}</dd></div>
              <div><dt>Estágio</dt><dd>{r.estagio}</dd></div>
              <div><dt>Grupo</dt><dd>{r.grupo}</dd></div>
              <div><dt>Méritos</dt><dd>{r.meritos}</dd></div>
              <div><dt>Yuls</dt><dd>{fmt(r.yuls)}</dd></div>
              <div><dt>Cristais</dt><dd>{r.cristais}</dd></div>
            </dl>
          </article>
        ))}
      </div>
      <p class="t-body" style="margin-top:28px" data-reveal>{missaoRegras.requisitos}</p>
    </div>
  </section>

  <section class="sec sec--line">
    <div class="wrap grid" style="align-items:start">
      <div class="c-1-6 stack" style="--s:1.2rem">
        <span class="eyebrow" data-reveal><b>03</b>Limite</span>
        <h2 class="t-h2" data-split>Duas missões <em>a cada 24 horas</em>.</h2>
        <p class="t-body" data-reveal>{missaoRegras.limite}</p>
      </div>
      <div class="c-7-12 stack" style="--s:1.2rem">
        <span class="eyebrow" data-reveal><b>04</b>Interferência e metagaming</span>
        <h2 class="t-h2" data-split>Invadir <em>com motivo</em>.</h2>
        <p class="t-body" data-reveal>{missaoRegras.interferencia}</p>
      </div>
    </div>
    <div class="wrap" style="margin-top:clamp(48px,7vw,100px)">
      <ImageSlot src="missoes/interferencia" label="Generais e Veio Negro na mesma missão" ratio="21 / 9" />
    </div>
  </section>

  <NextPage slug="missoes" />
</Base>
