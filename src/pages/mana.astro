---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import ImageSlot from '../components/ImageSlot.astro';
import NextPage from '../components/NextPage.astro';
import { manaRegras, custoGrau, controleFaixas, manaNiveis, romanos, tecnicas, tecnicasDiamond as td, runas, slugify } from '../data/canon.js';
---
<Base title="Mana" slug="mana" description="Reserva, custo, regeneração, esgotamento e afinidade de Mana, as Técnicas de Mana, as técnicas próprias de Diamond e as Técnicas Rúnicas.">
  <PageHero
    slug="mana"
    title="<em>Mana</em>"
    lead="Mana é o combustível de toda magia. Em Diamond, onde a terra quase não tem mana, recuperar é mais difícil que em qualquer outro reino."
    intro="O personagem gasta Mana ao lançar feitiços e usar Técnicas, recupera com o tempo e fica exausto quando ela acaba."
    image="mana/capa"
    imageLabel="Mana se acumulando ao redor de um mago"
  />

  <section class="sec">
    <div class="wrap">
      <SectionHead num="01" label="Regras da Mana" title="Gastar, recuperar, <em>esgotar</em>." />
      <div class="cols-3">
        {manaRegras.map((r, i) => (
          <article class="card" data-reveal>
            <span class="card__num">0{i + 1}</span>
            <h3 class="t-h3 card__title">{r.nome}</h3>
            <p class="card__text">{r.texto}</p>
            {r.nome === 'Custo' && (
              <dl class="kv" style="margin-top:18px">
                {custoGrau.map(([g, c]) => <><dt>Grau {g}</dt><dd>{c} de Mana</dd></>)}
              </dl>
            )}
          </article>
        ))}
        <article class="card" data-reveal style="padding:0;overflow:hidden">
          <ImageSlot src="mana/camara-de-mana" label="Câmara de Mana do Lapidário" ratio="1 / 1" />
        </article>
      </div>
    </div>
  </section>

  <section class="sec sec--line sec--raise" id="custo">
    <div class="wrap">
      <SectionHead num="02" label="Calculadora" title="Quanto custa <em>o seu feitiço</em>?" lead="Os descontos se somam até 50%. A Instabilidade do Mago do Caos aumenta o custo em 10% depois dos descontos." />
      <div class="sim" data-sim="custo" data-graus={JSON.stringify(custoGrau)} data-faixas={JSON.stringify(controleFaixas)} data-niveis={JSON.stringify(manaNiveis)} data-reveal>
        <div class="sim__grid">
          <div class="sim__side">
            <div class="field"><label for="c-grau">Grau do feitiço</label><select class="select" id="c-grau" name="grau">{custoGrau.map(([g, c], i) => <option value={i} selected={i === 2}>Grau {g} · {c} de Mana</option>)}</select></div>
            <div class="field"><label for="c-ctrl">Controle Mágico <output data-out>0%</output></label><input type="range" id="c-ctrl" name="ctrl" min="0" max="100" step="1" value="25" /></div>
            <div class="field"><label for="c-mae">Maestria do feitiço</label><select class="select" id="c-mae" name="mae"><option value="0">0 · recém-criado</option><option value="1">1 · -10%</option><option value="2">2 · +1 Acréscimo</option><option value="3">3 · sem encantamento, -20% no total</option></select></div>
          </div>
          <div class="sim__side">
            <div class="field"><label for="c-mana">Sua reserva</label><select class="select" id="c-mana" name="mana">{manaNiveis.map((m, i) => <option value={i} selected={i === 1}>Mana {romanos[i]} · {m.toLocaleString('pt-BR')}</option>)}</select></div>
            <div class="field">
              <span class="lbl">Modificadores</span>
              <label class="chip" style="cursor:pointer;justify-content:flex-start;gap:10px"><input type="checkbox" name="arcano" /> Fluxo Refinado (Mago Arcano, externalizado)</label>
              <label class="chip" style="cursor:pointer;justify-content:flex-start;gap:10px"><input type="checkbox" name="caos" /> Instabilidade (Mago do Caos)</label>
              <label class="chip" style="cursor:pointer;justify-content:flex-start;gap:10px"><input type="checkbox" name="elfo" /> Comunhão com a Mana (Elfo)</label>
            </div>
          </div>
        </div>
        <div class="sim__out" aria-live="polite"><p class="sim__result" data-result></p><p class="sim__why" data-why></p></div>
      </div>
    </div>
  </section>

  <section class="sec sec--line" id="tecnicas">
    <div class="wrap">
      <SectionHead num="03" label="Técnicas de Mana" title="Manipular a mana <em>fora do Grimório</em>." lead="Cada Técnica exige um Estágio e um Controle mínimos e é aprendida com Treinos de Técnica: 5 treinos com um mentor ou 8 sozinho, 1 por ciclo de 24 horas, ação mínima de 800 caracteres." />
      <div class="cols-3">
        {tecnicas.map((t) => (
          <article class="card" data-reveal style="padding:0;overflow:hidden">
            <ImageSlot src={`mana/${slugify(t.nome)}`} label={t.nome} ratio="16 / 10" compact />
            <div style="padding:clamp(20px,2.2vw,28px)">
              <div class="chips"><span class="chip chip--mana">{t.estagio} Estágio</span><span class="chip">Controle {t.controle}</span></div>
              <h3 class="t-h3 card__title">{t.nome}</h3>
              <p class="card__text">{t.texto}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="t-small" style="margin-top:24px" data-reveal>Técnicas próprias de família, como a Leitura de Ki dos Sukehiro, não seguem esta tabela.</p>
    </div>
  </section>

  <section class="sec sec--line sec--raise" id="diamond">
    <div class="wrap">
      <SectionHead num="04" label="Só em Diamond" title="Tirar mana <em>do pó</em>." lead={td.texto} />
      <div class="cols-3">
        {td.lista.map((t) => (
          <article class="card" data-reveal style="padding:0;overflow:hidden">
            <ImageSlot src={`mana/${slugify(t.nome)}`} label={t.nome} ratio="16 / 10" compact />
            <div style="padding:clamp(20px,2.2vw,28px)">
              <div class="chips"><span class="chip chip--mana">{t.estagio} Estágio</span><span class="chip">Controle {t.controle}</span></div>
              <h3 class="t-h3 card__title">{t.nome}</h3>
              <p class="t-small" style="margin-top:6px"><b>Quem aprende:</b> {t.quem}</p>
              <p class="card__text">{t.texto}</p>
              <p class="t-small tec__ideia">Ideia: {t.ideia}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec--line chap--paper" id="runas">
    <div class="wrap">
      <SectionHead num="05" label="Runas" title="Um disco é <em>uma runa</em> em cristal." lead={runas.texto} />
      <div class="cols-3">
        {runas.lista.map((t) => (
          <article class="card" data-reveal>
            <div class="chips"><span class="chip chip--mana">{t.estagio} Estágio</span><span class="chip">Controle {t.controle}</span></div>
            <h3 class="t-h3 card__title">{t.nome}</h3>
            <p class="card__text">{t.texto}</p>
            {t.ideia && <p class="t-small tec__ideia">Ideia: {t.ideia}</p>}
          </article>
        ))}
      </div>
      <div class="btns" style="margin-top:32px" data-reveal><a class="btn" href="/discos/">Ver os Discos</a></div>
    </div>
  </section>

  <NextPage slug="mana" />
</Base>
