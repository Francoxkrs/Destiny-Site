---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { eventos, estadoNome, estadoKanji } from '../data/eventos.js';
import { TIPOS } from '../lib/calendario.js';
import '../styles/calendario.css';

const vivos = eventos.filter((e) => e.estado === 'ativo' || e.estado === 'sempre').length;
const breve = eventos.filter((e) => e.estado === 'breve').length;
const passados = eventos.filter((e) => e.estado === 'passado').length;
const primeiroPassado = eventos.findIndex((e) => e.estado === 'passado');
const md = (t) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\*\*(.+?)\*\*/g, '<b>$1</b>').replace(/`([^`]+)`/g, '<code>$1</code>');
const nomeR = { lendario: 'Lendário', epico: 'Épico', raro: 'Comum' };
---
<Base title="Eventos" slug="eventos" aba="eventos" description="Os eventos do Black Destiny: o que está valendo agora no servidor, o que é para sempre, o que vem por aí e o Arquivo do que já aconteceu.">
  <div class="ev" data-eventos>
    <header class="ev-hd wrap">
      <span class="eyebrow"><b>祭</b>Mural de Diamond</span>
      <h1 class="ev-hd__t">Eventos</h1>
      <p class="ev-hd__c"><span><b>{vivos}</b> valendo</span><span><b>{breve}</b> em breve</span>{passados > 0 && <span><b>{passados}</b> no Arquivo</span>}</p>
      <div class="ev-abas" role="tablist" aria-label="Eventos">
        <button type="button" role="tab" id="ev-aba-mural" aria-controls="ev-mural" aria-selected="true" data-aba="mural"><span aria-hidden="true">祭</span>Mural</button>
        <button type="button" role="tab" id="ev-aba-cal" aria-controls="calendario" aria-selected="false" data-aba="calendario"><span aria-hidden="true">暦</span>Calendário</button>
      </div>
    </header>

    <!-- CALENDÁRIO: o que a Staff marca na Sala de Testes (/api/calendario) -->
    <section class="cal wrap" id="calendario" role="tabpanel" aria-labelledby="ev-aba-cal" data-cal hidden>
      <div class="cal-topo">
        <button type="button" class="cal-seta" data-cal-mes="-1" aria-label="Mês anterior">‹</button>
        <h2 class="cal-mes" data-cal-titulo aria-live="polite">Calendário</h2>
        <button type="button" class="cal-seta" data-cal-mes="1" aria-label="Próximo mês">›</button>
        <button type="button" class="cal-hoje" data-cal-hoje>Hoje</button>
      </div>
      <ul class="cal-leg" aria-label="Tipos">
        {Object.entries(TIPOS).map(([id, t]) => <li style={`--c:${t.cor}`}><span aria-hidden="true">{t.kanji}</span>{t.nome}</li>)}
      </ul>
      <div class="cal-corpo">
        <div class="cal-grade" data-cal-grade role="grid" aria-label="Dias do mês"></div>
        <aside class="cal-dia" data-cal-dia aria-live="polite">
          <p class="t-label" data-cal-dia-t>Escolha um dia</p>
          <ol class="cal-agenda" data-cal-agenda></ol>
        </aside>
      </div>
      <p class="cal-nota" data-cal-nota>Horários de Brasília.</p>
      <script type="application/json" id="cal-tipos" set:html={JSON.stringify(TIPOS)} />
    </section>

    <div class="ev-corpo wrap" id="ev-mural" role="tabpanel" aria-labelledby="ev-aba-mural" data-mural>
      <!-- sumário: lista de capítulos -->
      <nav class="ev-lista" aria-label="Eventos" data-lenis-prevent>
        <p class="ev-lista__h t-label">目次 · Sumário</p>
        {eventos.map((e, i) => (
          <Fragment>
          {i === primeiroPassado && <p class="ev-lista__h ev-lista__h--arq t-label">記録 · Arquivo — já aconteceu</p>}
          <a href={`#${e.id}`} class="ev-item" data-ev={e.id} data-estado={e.estado} aria-current={i === 0 ? 'true' : undefined}>
            <span class="ev-item__n">{String(i + 1).padStart(2, '0')}</span>
            <span class="ev-item__b">
              <small>{e.tipo}</small>
              <b>{e.nome}</b>
              <span class="ev-item__q">{e.quando}</span>
            </span>
            <span class="ev-item__selo" title={estadoNome[e.estado]}>{estadoKanji[e.estado]}</span>
          </a>
          </Fragment>
        ))}
      </nav>

      <!-- painéis -->
      <div class="ev-paineis">
        {eventos.map((e, i) => (
          <article class="ev-p" id={e.id} data-painel={e.id} data-estado={e.estado}>
            <div class="ev-p__arte">
              <img src={e.img} alt="" loading={i ? 'lazy' : 'eager'} />
              <span class="ev-p__k" aria-hidden="true">{e.kanji}</span>
              <span class="ev-p__estado">{estadoNome[e.estado]}</span>
            </div>
            <div class="ev-p__txt">
              <p class="ev-p__tipo t-label">{e.tipo} · {e.quando}</p>
              <h2 class="ev-p__t">{e.nome}</h2>
              <p class="ev-p__res">{e.resumo}</p>
              <p class="ev-p__body">{e.texto}</p>
              {e.passos.length > 0 && (
                <div class="ev-p__bloco">
                  <h3 class="t-label">Como participar</h3>
                  <ol class="ev-passos">{e.passos.map((p) => <li><span set:html={md(p)} /></li>)}</ol>
                </div>
              )}
              {e.elenco && (
                <div class="ev-p__bloco">
                  <h3 class="t-label">Quem esteve lá</h3>
                  <ul class="ev-elenco">{e.elenco.map((p) => <li><b>{p.nome}</b><small>{p.papel}</small></li>)}</ul>
                </div>
              )}
              {e.marcas && (
                <div class="ev-p__bloco">
                  <h3 class="t-label">O que mudou no mundo</h3>
                  <ul class="ev-marcas">{e.marcas.map((m) => <li><span set:html={md(m)} /></li>)}</ul>
                </div>
              )}
              {e.premios.length > 0 && (
                <div class="ev-p__bloco">
                  <h3 class="t-label">Recompensas</h3>
                  <ul class="ev-premios">
                    {e.premios.map((p) => <li data-r={p.raro}><span class="ev-premios__d" aria-label={nomeR[p.raro]}>{p.raro === 'lendario' ? '◆◆◆' : p.raro === 'epico' ? '◆◆' : '◆'}</span><b>{p.nome}</b><small>{p.nota}</small></li>)}
                  </ul>
                </div>
              )}
              {(e.comandos || e.link || e.video) && (
                <div class="ev-p__pe">
                  {e.comandos && <p class="ev-cmds">{e.comandos.map((c) => <code>{c}</code>)}</p>}
                  {e.video && <a class="btn" href={e.video.href} target="_blank" rel="noopener">{e.video.texto} <Arrow /></a>}
                  {e.link && <a class="btn" href={e.link.href}>{e.link.texto} <Arrow /></a>}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</Base>

<script>
  import '../scripts/calendario.js';
</script>

<script>
  // Um painel por vez no computador; no celular, todos em coluna (sem JavaScript também).
  const raiz = document.querySelector<HTMLElement>('[data-eventos]')!;
  const itens = Array.from(raiz.querySelectorAll<HTMLAnchorElement>('[data-ev]'));
  const paineis = Array.from(raiz.querySelectorAll<HTMLElement>('[data-painel]'));
  const larga = matchMedia('(min-width: 1000px)');
  function mostra(id: string, anima = true) {
    if (!larga.matches) return;
    itens.forEach((a) => (a.dataset.ev === id ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    paineis.forEach((p) => {
      const on = p.dataset.painel === id;
      p.hidden = !on;
      if (on && anima && !matchMedia('(prefers-reduced-motion: reduce)').matches) p.animate([{ clipPath: 'inset(0 100% 0 0)' }, { clipPath: 'inset(0 0 0 0)' }], { duration: 650, easing: 'cubic-bezier(.76,0,.24,1)' });
    });
  }
  itens.forEach((a) => a.addEventListener('click', (e) => {
    if (!larga.matches) return;
    e.preventDefault(); e.stopPropagation();
    mostra(a.dataset.ev!);
    try { history.replaceState(null, '', `#${a.dataset.ev}`); } catch { /* sem histórico */ }
  }, true));
  const inicial = location.hash.slice(1);
  mostra(paineis.some((p) => p.dataset.painel === inicial) ? inicial : paineis[0].dataset.painel!, false);
  larga.addEventListener('change', () => { if (!larga.matches) paineis.forEach((p) => (p.hidden = false)); else mostra(paineis[0].dataset.painel!, false); });
</script>
