---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PageNav from '../components/PageNav.astro';
import SectionHead from '../components/SectionHead.astro';
import NextPage from '../components/NextPage.astro';
import { artesSombrias as a } from '../data/canon.js';

const abas = [['negativa', 'Mana Negativa'], ['corrupcao', 'Corrupção'], ['obscuras', 'Artes Obscuras'], ['demoniacas', 'Artes Demoníacas'], ['quem', 'Quem tem acesso']];
---
<Base title="Artes Sombrias" slug="artes-sombrias" description="Mana Negativa, Corrupção, Artes Obscuras, Artes Demoníacas, pactos com Demônios e o Grimório Demoníaco.">
  <PageHero
    slug="artes-sombrias"
    title="Artes <em>Sombrias</em>"
    lead="Tudo o que usa a mana do Submundo: Feitiços Obscuros, pactos com Demônios e o preço que eles cobram."
    intro={a.texto}
  />

  <PageNav items={abas} />

  <section class="sec" id="negativa">
    <div class="wrap">
      <SectionHead num="01" label="Mana Negativa" title="A mana <em>ao contrário</em>." />
      <dl class="gifts">
        {a.negativa.map(([n, t]) => <div data-reveal><dt>{n}</dt><dd>{t}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="sec sec--line sec--raise" id="corrupcao">
    <div class="wrap">
      <SectionHead num="02" label="Corrupção" title="O preço <em>na ficha</em>." lead={a.corrupcao.texto} />
      <dl class="gifts">
        {a.corrupcao.regras.map(([n, t]) => <div data-reveal><dt>{n}</dt><dd>{t}</dd></div>)}
      </dl>
      <div class="corr" style="margin-top:clamp(32px,4vw,56px)">
        {a.corrupcao.faixas.map(([n, nome, ef]) => (
          <div data-reveal><span class="corr__n">{n}</span><h4 class="t-h4">{nome}</h4><p class="t-body">{ef}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec--line" id="obscuras">
    <div class="wrap">
      <SectionHead num="03" label="Artes Obscuras" title="Rituais, maldições <em>e vodu</em>." lead={a.obscuras.texto} />
      <dl class="gifts">
        {a.obscuras.regras.map(([n, t]) => <div data-reveal><dt>{n}</dt><dd>{t}</dd></div>)}
      </dl>
      <h3 class="t-h3" style="margin-top:clamp(40px,5vw,72px)" data-reveal>Feitiços Obscuros de exemplo</h3>
      <div class="cols-3" style="margin-top:20px">
        {a.obscuras.tecnicas.map((t) => (
          <article class="card" data-reveal>
            <div class="chips"><span class="chip chip--mana">{t.estagio} Estágio</span></div>
            <h3 class="t-h3 card__title">{t.nome}</h3>
            <p class="card__text">{t.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec--line chap--paper" id="demoniacas">
    <div class="wrap">
      <SectionHead num="04" label="Artes Demoníacas" title="Pactos <em>com Demônios</em>." lead={a.demoniacas.texto} />
      <ol class="steps" style="margin-top:20px">
        {a.demoniacas.pacto.map(([n, t]) => <li data-reveal><div><h4>{n}</h4><p>{t}</p></div></li>)}
      </ol>
      <p class="t-lead" style="margin-top:clamp(32px,4vw,56px)" data-reveal>{a.grimorio}</p>
    </div>
  </section>

  <section class="sec sec--line" id="quem">
    <div class="wrap">
      <SectionHead num="05" label="Quem tem acesso" title="De nascença <em>ou de herança</em>." lead="Fora desses casos, as Artes Sombrias se aprendem com o Conhecimento certo, em eventos ou com quem já sabe." />
      <dl class="gifts">
        {a.quem.map(([n, t]) => <div data-reveal><dt>{n}</dt><dd>{t}</dd></div>)}
      </dl>
      <div class="btns" style="margin-top:32px" data-reveal>
        <a class="btn" href="/conhecimentos/">Conhecimentos</a>
        <a class="btn" href="/magia/">Grimórios</a>
        <a class="btn" href="/familias/">Famílias</a>
      </div>
    </div>
  </section>

  <NextPage slug="artes-sombrias" />
</Base>
