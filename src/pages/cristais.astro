---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Cristal from '../components/portal/Cristal.astro';
import { lerSessao } from '../lib/sessao.js';
import { banco } from '../lib/db.js';
import { env, pagamentoPronto } from '../lib/env.js';
import { conferirAbertos } from '../lib/compras.js';
import { aprovado, moeda, primeiraCompra, pacotes, selo, presente, loja, nuncaAVenda, regras } from '../data/cristais.js';
import { altar, garantia, inscricao } from '../data/altar.js';
export const prerender = false;

const sessao = lerSessao(Astro.cookies);
Astro.response.headers.set('cache-control', 'private, no-store');
let saldo = null;
if (sessao) {
  try {
    const db = await banco();
    // Pix pago com a página fechada (e sem o aviso do Mercado Pago): credita agora, antes de mostrar o saldo
    if (db && pagamentoPronto()) await conferirAbertos(db, env.mpToken, sessao.id).catch(() => null);
    const c = db && (await db.collection('contas').findOne({ userId: sessao.id }, { projection: { cp: 1 } })); saldo = db ? (c?.cp ?? 0) : null;
  } catch { /* sem saldo */ }
}
const vende = pagamentoPronto();
const fmt = new Intl.NumberFormat('pt-BR');
const brl = (v) => v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
const grupos = [...new Set(loja.map((i) => i.grupo))];
const kanjiPremio = { moldura: '額', titulo: '名', classe: '魔' };
const pctBonus = (p) => Math.round((p.bonus / p.base) * 100);
const maxBonus = Math.max(...pacotes.map(pctBonus));
const cpPorReal = (cp, r) => Math.round(cp / r);
const seloVezes = Math.round((selo.total / selo.preco) / (pacotes[0].cp / pacotes[0].preco));
// metas da calculadora: só itens que existem na loja e no Altar
const metas = [
  { id: 'i10', nome: '10 Inscrições do Altar', cp: inscricao.cp10 },
  { id: 'passe', nome: 'Passe Premium da temporada', cp: loja.find((i) => i.nome.startsWith('Passe'))?.cp ?? 600 },
  { id: 'lend', nome: `Lendário garantido (${garantia.lendario} Inscrições)`, cp: Math.ceil(garantia.lendario / 10) * inscricao.cp10 },
  { id: 'classe', nome: 'Classe de Mago à escolha', cp: loja.find((i) => i.id === 'classe-escolha')?.cp ?? 900 },
  { id: 'raca', nome: 'Raça à escolha', cp: loja.find((i) => i.id === 'raca-escolha')?.cp ?? 1200 },
  { id: 'skip', nome: '3 Skip Treino (uma semana)', cp: 3 * (loja.find((i) => i.id === 'skip-treino')?.cp ?? 120) },
];
---
<Base title="Cristais Prismáticos" slug="cristais" aba="cristais" description="Cristais Prismáticos: a moeda da sua conta no Black Destiny. Pacotes, Selo Mensal, presente para amigos e a loja da conta.">
  <div class="cp">
    <header class="cp-hd wrap">
      <div>
        <span class="eyebrow"><b>晶</b>Moeda da conta · {moeda.sigla}</span>
        <h1 class="cp-hd__t">Cristais <em>Prismáticos</em></h1>
        <p class="t-body">{moeda.texto}</p>
      </div>
      <div class="cp-saldo">
        <span class="hcp__gem cp-saldo__gem" aria-hidden="true"></span>
        <p class="t-label">Seu saldo</p>
        {saldo != null ? <b class="cp-saldo__n" data-saldo>{fmt.format(saldo)} <small>CP</small></b> : sessao ? <b class="cp-saldo__nd">Ainda indisponível</b> : <a class="cp-saldo__in" href="/api/auth/login?volta=/cristais/">Entre para ver</a>}
      </div>
    </header>

    {!aprovado && <p class="cp-aviso wrap" role="status"><b>Proposta</b>Números da proposta de monetização, ainda sem a aprovação final. Nada aqui cobra: a compra pelo Pix abre quando a Staff liberar.</p>}

    <!-- primeira compra -->
    <section class="cp-pc wrap" aria-labelledby="cp-pc">
      <div class="cp-pc__in">
        <div class="cp-pc__txt">
          <span class="cp-pc__selo" aria-hidden="true">初</span>
          <p class="t-label">Uma vez por conta</p>
          <h2 id="cp-pc" class="cp-pc__t">{primeiraCompra.titulo}</h2>
          <p>{primeiraCompra.texto}</p>
          <p class="cp-pc__letra">{primeiraCompra.letra}</p>
        </div>
        <ul class="cp-pc__premios">
          {primeiraCompra.premios.map((p) => (
            <li><span class="cp-pc__k" aria-hidden="true">{kanjiPremio[p.icone]}</span><b>{p.nome}</b><small>{p.texto}</small></li>
          ))}
        </ul>
        <div class="cp-pc__arte" aria-hidden="true"><Cristal tamanho={6} id="pc" /></div>
      </div>
    </section>

    <!-- pacotes -->
    <section class="cp-sec wrap" aria-labelledby="cp-pac">
      <div class="cp-sec__h"><h2 id="cp-pac" class="t-h2">Pacotes</h2><p class="t-body">Pix ou cartão pelo Mercado Pago. Os Cristais entram na sua conta assim que o pagamento é confirmado. Do menor ao maior, até {brl(pacotes.at(-1).preco)}.</p></div>
      <ul class="cp-pacs">
        {pacotes.map((p) => (
          <li class:list={['cp-pac', p.destaque && 'cp-pac--dest']}>
            {p.destaque && <span class="cp-pac__tag">{p.destaque}</span>}
            <div class="cp-pac__arte"><img src={`/img/cristais/pacote-${p.n}.webp`} alt={`Arte do pacote ${p.nome}`} width="800" height="800" loading="lazy" decoding="async" /></div>
            <p class="cp-pac__vol t-label">Nº {String(p.n).padStart(2, '0')}</p>
            <h3 class="cp-pac__nome">{p.nome}</h3>
            <p class="cp-pac__cp"><b>{fmt.format(p.cp)}</b> CP</p>
            <p class="cp-pac__bonus">{p.bonus ? <><span>+{fmt.format(p.bonus)}</span> de bônus · {pctBonus(p)}%</> : 'Sem bônus'}</p>
            <span class="cp-pac__barra" style={`--b:${(pctBonus(p) / maxBonus) * 100}%`} aria-hidden="true"></span>
            <p class="cp-pac__vale">≈ {Math.floor(p.cp / inscricao.cp)} {Math.floor(p.cp / inscricao.cp) === 1 ? 'Inscrição' : 'Inscrições'}<small>{cpPorReal(p.cp, p.preco)} CP por real</small></p>
            {vende && sessao ? <button class="cp-pac__btn" type="button" data-comprar={p.n} data-nome={p.nome} data-cp={p.cp} data-preco={p.preco}><span>{brl(p.preco)}</span><small>Comprar</small></button>
              : vende ? <a class="cp-pac__btn" href="/api/auth/login?volta=/cristais/"><span>{brl(p.preco)}</span><small>Entrar</small></a>
              : <button class="cp-pac__btn" type="button" disabled><span>{brl(p.preco)}</span><small>Em breve</small></button>}
          </li>
        ))}
      </ul>
    </section>

    <!-- calculadora -->
    <section class="cp-calc wrap" aria-labelledby="cp-calc-t" data-calc data-pacotes={JSON.stringify(pacotes.map((p) => ({ nome: p.nome, cp: p.cp, preco: p.preco })))} data-selo={JSON.stringify(selo)} data-saldo={saldo ?? 0}>
      <div class="cp-calc__l">
        <span class="eyebrow"><b>算</b>Calculadora</span>
        <h2 id="cp-calc-t" class="t-h2">Do que você <em>precisa</em>?</h2>
        <p class="t-body">Marque o que quer pegar. A calculadora soma os CP e acha o jeito mais barato de chegar lá, sem sobrar dinheiro na mesa.</p>
        <ul class="cp-metas">
          {metas.map((m) => <li><label><input type="checkbox" value={m.cp} data-meta={m.id} /><span>{m.nome}</span><em>{fmt.format(m.cp)} CP</em></label></li>)}
        </ul>
      </div>
      <div class="cp-calc__r" aria-live="polite">
        <p class="t-label">Você precisa de</p>
        <p class="cp-calc__total"><b data-total>0</b> CP</p>
        <div class="cp-calc__plano" data-plano><p class="cp-calc__vazio">Marque pelo menos um item.</p></div>
      </div>
    </section>

    <!-- vitrine do Altar -->
    <a class="cp-alt wrap" href="/altar/">
      <span class="cp-alt__img"><img src={altar.destaque.img} alt="" loading="lazy" /></span>
      <span class="cp-alt__txt">
        <span class="t-label">{altar.temporada} · Destaque{altar.proposta ? ' (proposta)' : ''}</span>
        <b>{altar.destaque.nome}</b>
        <span>{altar.destaque.texto}</span>
        <span class="cp-alt__g"><i>Garantido na {garantia.lendario}ª Inscrição</i><i>Sem 50/50</i><i>Chances sempre à vista</i></span>
      </span>
      <span class="btn btn--solid tr-sm">Ver o Altar <Arrow /></span>
    </a>

    <!-- selo e presente -->
    <section class="cp-duo wrap">
      <article class="cp-selo">
        <span class="cp-selo__k" aria-hidden="true">月</span>
        <p class="t-label">Assinatura de 30 dias</p>
        <h2 class="cp-selo__t">{selo.nome}</h2>
        <p class="cp-selo__n"><b>{fmt.format(selo.total)}</b> CP no mês</p>
        <ol class="cp-selo__dias" aria-label={`${selo.agora} CP na hora e ${selo.porDia} por dia`}>
          <li class="is-agora"><b>{selo.agora}</b><small>na hora</small></li>
          {Array.from({ length: 6 }, (_, i) => <li><b>+{selo.porDia}</b><small>dia {i + 1}</small></li>)}
          <li class="is-mais"><b>…</b><small>até o dia {selo.dias}</small></li>
        </ol>
        <p class="cp-selo__vale">{seloVezes}× mais CP por real que a Lasca, se você usar /selo todo dia.</p>
        <p class="t-small">{selo.texto}</p>
        <button class="cp-pac__btn" type="button" disabled><span>{brl(selo.preco)}</span><small>Em breve</small></button>
      </article>
      <article class="cp-pres">
        <span class="cp-selo__k" aria-hidden="true">贈</span>
        <p class="t-label">Para outro membro</p>
        <h2 class="cp-selo__t">{presente.titulo}</h2>
        <p class="t-body">{presente.texto}</p>
        <p class="cp-pres__breve">Em breve. Hoje a compra é só para a sua própria conta.</p>
        <p class="cp-pres__bilhete"><span>Bilhete</span>“Pela primeira missão que você me tirou do Fosso.”</p>
      </article>
    </section>

    <!-- loja da conta -->
    <section class="cp-sec wrap" aria-labelledby="cp-loja">
      <div class="cp-sec__h"><h2 id="cp-loja" class="t-h2">Loja da <em>conta</em></h2><p class="t-body">Tudo com resultado conhecido. O item cai na sua /bolsa do bot na hora. O que tem vaga limitada ou define o topo do poder só se ganha jogando.</p></div>
      <p class="cp-loja__msg" data-loja-msg aria-live="polite" hidden></p>
      <div class="cp-loja" data-loja data-logado={sessao ? '1' : ''}>
        {grupos.map((g) => (
          <div class="cp-loja__g">
            <h3 class="t-label">{g}</h3>
            <ul>
              {loja.filter((i) => i.grupo === g).map((i) => (
                <li class:list={[!i.chave && !i.onde && 'is-breve']}>
                  <span><b>{i.nome}</b>{(i.nota || i.limite) && <small>{[i.nota, i.limite].filter(Boolean).join(' · ')}</small>}</span>
                  <span class="cp-loja__c">
                    <em>{fmt.format(i.cp)} <small>CP</small></em>
                    {i.chave ? <button class="cp-loja__btn" type="button" data-comprar={i.id} data-cp={i.cp} data-nome={i.nome}>Comprar</button>
                      : i.onde?.href ? <a class="cp-loja__btn cp-loja__btn--link" href={i.onde.href}>{i.onde.rotulo}</a>
                      : i.onde ? <span class="cp-loja__onde">{i.onde.rotulo}</span>
                      : <span class="cp-loja__onde">Em breve</span>}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      {loja.some((i) => i.grupo === 'Giros') && <p class="cp-loja__altar"><a class="btn btn--solid" href="/altar/">Abrir o Altar dos Vestígios <Arrow /></a></p>}
    </section>

    <!-- nunca à venda + regras -->
    <section class="cp-muro">
      <div class="wrap cp-muro__in">
        <div>
          <span class="eyebrow"><b>禁</b>O muro</span>
          <h2 class="t-h2">Nunca à <em>venda</em>.</h2>
          <p class="t-body">Por nenhum caminho pago. Quem não paga chega no mesmo Estágio, no mesmo tempo.</p>
        </div>
        <ul class="cp-muro__l">{nuncaAVenda.map((n) => <li>{n}</li>)}</ul>
        <ul class="cp-muro__r">{regras.map((n) => <li>{n}</li>)}</ul>
      </div>
    </section>
  </div>

  {vende && sessao && (
    <dialog class="cp-pix" data-pix aria-labelledby="cp-pix-t">
      <div class="cp-pix__in">
        <button class="cp-pix__x" type="button" data-fechar aria-label="Fechar">×</button>
        <p class="t-label"><b>晶</b> <span data-via>Mercado Pago</span></p>
        <h2 id="cp-pix-t" class="cp-pix__t" data-titulo>Pacote</h2>
        <p class="cp-pix__res" data-resumo></p>

        <div class="cp-pix__corpo" data-etapa="escolher">
          <p class="t-label">Como você quer pagar?</p>
          <div class="cp-pix__metodos">
            <button class="cp-pix__met" type="button" data-metodo="pix">
              <span class="cp-pix__met-k" aria-hidden="true">即</span>
              <b>Pix</b><small>QR Code aqui mesmo. Confirma em segundos.</small>
            </button>
            <button class="cp-pix__met" type="button" data-metodo="cartao">
              <span class="cp-pix__met-k" aria-hidden="true">札</span>
              <b>Cartão</b><small>Crédito (até 12x) ou débito, na página segura do Mercado Pago.</small>
            </button>
          </div>
          <p class="cp-pix__nota">O número do cartão nunca passa pelo site do Black Destiny.</p>
        </div>

        <div class="cp-pix__corpo" data-etapa="carregando" hidden><p class="cp-pix__msg" data-carregando>Gerando o seu Pix…</p></div>

        <div class="cp-pix__corpo" data-etapa="pagar" hidden>
          <div class="cp-pix__qr"><img data-qr alt="QR Code do Pix" width="220" height="220" /></div>
          <ol class="cp-pix__passos">
            <li>Abra o app do seu banco e escolha <b>Pix</b>.</li>
            <li>Leia o QR Code ou use o <b>copia e cola</b>.</li>
            <li>Pague e deixe esta janela aberta. Os Cristais entram sozinhos.</li>
          </ol>
          <label class="cp-pix__cc"><span class="t-label">Pix copia e cola</span><input data-cc readonly /></label>
          <div class="cp-pix__acoes">
            <button class="btn btn--solid" type="button" data-copiar>Copiar código</button>
            <a class="btn" data-link target="_blank" rel="noopener" hidden>Abrir no Mercado Pago</a>
          </div>
          <p class="cp-pix__espera" aria-live="polite"><span class="cp-pix__pulso" aria-hidden="true"></span><span data-espera>Esperando o pagamento</span> · vence em <b data-tempo>30:00</b></p>
          <button class="cp-pix__cancelar" type="button" data-cancelar>Desistir deste Pix</button>
        </div>

        <div class="cp-pix__corpo cp-pix__ok" data-etapa="pago" hidden aria-live="assertive">
          <span class="hcp__gem cp-pix__gem" aria-hidden="true"></span>
          <p class="cp-pix__ok-t">Pagamento confirmado</p>
          <p><b data-ganhou></b> CP na sua conta. Saldo agora: <b data-saldo-novo></b> CP.</p>
          <button class="btn btn--solid" type="button" data-fechar>Fechar</button>
        </div>

        <div class="cp-pix__corpo" data-etapa="fim" hidden>
          <p class="cp-pix__msg" data-fim></p>
          <button class="btn" type="button" data-fechar>Fechar</button>
        </div>
      </div>
    </dialog>
  )}
</Base>

<script>
  const c = document.querySelector<HTMLElement>('[data-calc]');
  if (c) {
    type P = { nome: string; cp: number; preco: number };
    const P = JSON.parse(c.dataset.pacotes!) as P[];
    const fmt = new Intl.NumberFormat('pt-BR');
    const brl = (v: number) => v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    // o combo mais barato que alcança a meta (até 4 de cada pacote; a lista é pequena)
    function melhor(meta: number) {
      let best: { q: number[]; preco: number; cp: number } | null = null;
      const q = new Array(P.length).fill(0);
      const rec = (i: number, cp: number, preco: number) => {
        if (best && preco >= best.preco) return;
        if (cp >= meta) { best = { q: [...q], preco, cp }; return; }
        if (i === P.length) return;
        for (let n = 0; n <= 4; n++) { q[i] = n; rec(i + 1, cp + n * P[i].cp, preco + n * P[i].preco); }
        q[i] = 0;
      };
      rec(0, 0, 0);
      return best as { q: number[]; preco: number; cp: number } | null;
    }
    const plano = c.querySelector<HTMLElement>('[data-plano]')!;
    const tot = c.querySelector<HTMLElement>('[data-total]')!;
    const roda = () => {
      const soma = [...c.querySelectorAll<HTMLInputElement>('[data-meta]:checked')].reduce((s, i) => s + Number(i.value), 0);
      // quem já tem saldo só precisa da diferença
      const tem = Math.max(0, Number(c.dataset.saldo) || 0);
      const meta = Math.max(0, soma - tem);
      tot.textContent = fmt.format(meta);
      if (!soma) { plano.innerHTML = '<p class="cp-calc__vazio">Marque pelo menos um item.</p>'; return; }
      if (!meta) { plano.innerHTML = `<p class="cp-calc__vazio">Seu saldo de ${fmt.format(tem)} CP já cobre tudo isso.</p>`; return; }
      const b = melhor(meta);
      if (!b) { plano.innerHTML = '<p class="cp-calc__vazio">Passa do que dá para comprar de uma vez.</p>'; return; }
      const itens = b.q.map((n, i) => (n ? `<li><b>${n}×</b> ${P[i].nome}<span>${brl(n * P[i].preco)}</span></li>` : '')).join('');
      const sobra = b.cp - meta;
      const teto = b.preco > 500 ? '<p class="cp-calc__nota">Passa do teto de R$ 500 por mês: dá para dividir em dois meses.</p>' : '';
      const jaTem = tem ? `<p class="cp-calc__nota">Já descontei os ${fmt.format(tem)} CP que você tem.</p>` : '';
      plano.innerHTML = `<ul>${itens}</ul><p class="cp-calc__preco"><span>Total</span><b>${brl(b.preco)}</b></p><p class="cp-calc__sobra">${sobra ? `Sobram ${fmt.format(sobra)} CP na conta.` : 'Sem sobra.'}</p>${teto}${jaTem}`;
    };
    c.addEventListener('change', roda);
    roda();
  }
</script>

<script>
  // Loja da conta: dois toques (Comprar → Confirmar) e o item cai na /bolsa do bot. O servidor confere saldo e limites.
  const raiz = document.querySelector<HTMLElement>('[data-loja]');
  const msg = document.querySelector<HTMLElement>('[data-loja-msg]');
  if (raiz && msg) {
    const fmt = new Intl.NumberFormat('pt-BR');
    const novaRef = () => (crypto.randomUUID?.() ?? `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 12)}`);
    const dizer = (html: string, erro = false) => { msg.hidden = false; msg.innerHTML = html; msg.classList.toggle('is-erro', erro); };
    let armado: HTMLButtonElement | null = null;
    let tempo = 0;
    const desarmar = () => { if (armado) { armado.textContent = 'Comprar'; armado.classList.remove('is-armado'); } armado = null; clearTimeout(tempo); };
    raiz.addEventListener('click', async (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-comprar]');
      if (!b || b.getAttribute('aria-busy') === 'true') return;
      if (!raiz.dataset.logado) { location.href = '/api/auth/login?volta=/cristais/%23cp-loja'; return; }
      if (armado !== b) {
        desarmar();
        armado = b;
        b.textContent = `Confirmar ${fmt.format(Number(b.dataset.cp))} CP`;
        b.classList.add('is-armado');
        tempo = window.setTimeout(desarmar, 5000);
        return;
      }
      desarmar();
      b.setAttribute('aria-busy', 'true');
      b.textContent = '...';
      try {
        const r = await fetch('/api/loja/comprar', { method: 'POST', headers: { 'content-type': 'application/json' }, credentials: 'same-origin', body: JSON.stringify({ tipo: 'loja', id: b.dataset.comprar, ref: novaRef() }) });
        const c = await r.json().catch(() => ({}));
        if (r.status === 401) { location.href = '/api/auth/login?volta=/cristais/%23cp-loja'; return; }
        if (r.status === 402 && c.falta?.cp) { dizer(`Faltam <b>${fmt.format(c.falta.cp)} CP</b> para ${b.dataset.nome}. Os pacotes estão no topo da página.`, true); return; }
        if (!r.ok) { dizer(c.erro || 'Não deu certo. Tente de novo.', true); return; }
        dizer(`<b>${b.dataset.nome}</b> está na sua /bolsa no bot. Saldo: ${fmt.format(c.conta.cp)} CP.`);
        const sd = document.querySelector('[data-saldo]'); if (sd) sd.innerHTML = `${fmt.format(c.conta.cp)} <small>CP</small>`;
        document.querySelectorAll('[data-sessao-cp-n]').forEach((el) => (el.textContent = fmt.format(c.conta.cp)));
      } catch {
        dizer('Sem conexão com o site. Confira a sua /bolsa no bot antes de tentar de novo.', true);
      } finally {
        b.removeAttribute('aria-busy');
        if (!b.classList.contains('is-armado')) b.textContent = 'Comprar';
      }
    });
  }
</script>

<script>
  // Compra pelo Pix: abre a janela, gera o Pix no servidor, mostra o QR e pergunta a cada 4 s se já pagou.
  const dlg = document.querySelector<HTMLDialogElement>('[data-pix]');
  if (dlg) {
    type Pedido = { id: string; status: string; nome: string; cp: number; valor: number; expiraEm: string | null; copiaCola: string | null; qr: string | null; link: string | null };
    const fmt = new Intl.NumberFormat('pt-BR');
    const brl = (v: number) => v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    const $ = <T extends HTMLElement>(sel: string) => dlg.querySelector<T>(sel)!;
    const etapa = (nome: string) => dlg.querySelectorAll<HTMLElement>('[data-etapa]').forEach((e) => (e.hidden = e.dataset.etapa !== nome));
    let atual: Pedido | null = null;
    let timer = 0, relogio = 0, falhas = 0;

    const parar = () => { clearTimeout(timer); clearInterval(relogio); };
    const fim = (msg: string) => { parar(); $('[data-fim]').textContent = msg; etapa('fim'); };
    const saldoNaPagina = (n: number) => { const el = document.querySelector('[data-saldo]'); if (el) el.innerHTML = `${fmt.format(n)} <small>CP</small>`; const h = document.querySelector('.hcp b'); if (h) h.textContent = fmt.format(n); };

    function pago(p: Pedido, saldo: number) {
      parar();
      $('[data-ganhou]').textContent = fmt.format(p.cp);
      $('[data-saldo-novo]').textContent = fmt.format(saldo);
      saldoNaPagina(saldo);
      etapa('pago');
    }

    function contar() {
      const vence = atual?.expiraEm ? new Date(atual.expiraEm).getTime() : 0;
      const tick = () => {
        const r = Math.max(0, Math.round((vence - Date.now()) / 1000));
        $('[data-tempo]').textContent = `${String(Math.floor(r / 60)).padStart(2, '0')}:${String(r % 60).padStart(2, '0')}`;
      };
      tick(); clearInterval(relogio); relogio = window.setInterval(tick, 1000);
    }

    async function conferir() {
      if (!atual || !dlg!.open) return;
      try {
        const r = await fetch(`/api/cristais/pedido?id=${atual.id}`, { cache: 'no-store' });
        const d = await r.json();
        falhas = 0;
        const p: Pedido | undefined = d.pedido;
        if (p?.status === 'pago') return pago(p, d.saldo);
        if (p?.status === 'expirado') return fim('Este Pix venceu sem pagamento. Se quiser, é só abrir de novo.');
        if (p?.status === 'cancelado') return fim('Este Pix foi cancelado. Nada foi cobrado.');
        if (!r.ok) $('[data-espera]').textContent = d.erro ?? 'Conferindo';
        else $('[data-espera]').textContent = 'Esperando o pagamento';
      } catch {
        falhas++;
        $('[data-espera]').textContent = falhas > 2 ? 'Sem conexão, tentando de novo' : 'Esperando o pagamento';
      }
      timer = window.setTimeout(conferir, falhas ? 8000 : 4000);
    }

    let escolhido: HTMLButtonElement | null = null;
    const carregando = (msg: string) => { $('[data-carregando]').textContent = msg; etapa('carregando'); };

    // 1º passo: escolher Pix ou cartão
    function abrir(btn: HTMLButtonElement) {
      parar();
      atual = null;
      escolhido = btn;
      $('[data-via]').textContent = 'Mercado Pago';
      $('[data-titulo]').textContent = btn.dataset.nome ?? 'Pacote';
      $('[data-resumo]').textContent = `${fmt.format(Number(btn.dataset.cp))} CP · ${brl(Number(btn.dataset.preco))}`;
      etapa('escolher');
      if (!dlg!.open) dlg!.showModal();
      dlg!.querySelector<HTMLButtonElement>('[data-metodo="pix"]')?.focus();
    }

    async function pedir(metodo: 'pix' | 'cartao') {
      const btn = escolhido;
      if (!btn) return;
      $('[data-via]').textContent = metodo === 'pix' ? 'Pix · Mercado Pago' : 'Cartão · Mercado Pago';
      carregando(metodo === 'pix' ? 'Gerando o seu Pix…' : 'Abrindo a página segura do Mercado Pago…');
      btn.setAttribute('aria-busy', 'true');
      try {
        const r = await fetch('/api/cristais/comprar', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ pacote: Number(btn.dataset.comprar), metodo }) });
        const d = await r.json().catch(() => ({}));
        if (!r.ok || !d.pedido) return fim(d.erro ?? 'Não consegui abrir o pagamento agora. Tente de novo em alguns minutos.');
        if (metodo === 'cartao') {
          if (!d.pedido.link) return fim('Não consegui abrir o pagamento com cartão agora.');
          window.location.assign(d.pedido.link);
          return;
        }
        atual = d.pedido as Pedido;
        const qr = $<HTMLImageElement>('[data-qr]');
        qr.src = atual.qr ?? '';
        qr.parentElement!.hidden = !atual.qr;
        $<HTMLInputElement>('[data-cc]').value = atual.copiaCola ?? '';
        const link = $<HTMLAnchorElement>('[data-link]');
        link.hidden = !atual.link; if (atual.link) link.href = atual.link;
        $('[data-copiar]').textContent = 'Copiar código';
        etapa('pagar');
        contar();
        timer = window.setTimeout(conferir, 4000);
      } catch {
        fim('Sem conexão com o site. Confira a internet e tente de novo.');
      } finally {
        btn.removeAttribute('aria-busy');
      }
    }

    document.querySelectorAll<HTMLButtonElement>('[data-comprar]').forEach((b) => b.addEventListener('click', () => abrir(b)));
    dlg.querySelectorAll<HTMLButtonElement>('[data-metodo]').forEach((b) => b.addEventListener('click', () => pedir(b.dataset.metodo as 'pix' | 'cartao')));

    // volta do cartão: /cristais/?compra=<id> → confere até o Mercado Pago confirmar
    const volta = new URLSearchParams(location.search).get('compra');
    if (volta && /^[a-f0-9]{24}$/i.test(volta)) {
      history.replaceState(null, '', location.pathname);
      let tentativas = 0;
      $('[data-via]').textContent = 'Cartão · Mercado Pago';
      $('[data-titulo]').textContent = 'Sua compra';
      $('[data-resumo]').textContent = '';
      carregando('Conferindo o pagamento com o Mercado Pago…');
      dlg.showModal();
      const olhar = async () => {
        if (!dlg.open) return;
        tentativas++;
        try {
          const r = await fetch(`/api/cristais/pedido?id=${volta}`, { cache: 'no-store' });
          const d = await r.json();
          const p: Pedido | undefined = d.pedido;
          if (p) { $('[data-titulo]').textContent = p.nome; $('[data-resumo]').textContent = `${fmt.format(p.cp)} CP · ${brl(p.valor)}`; }
          if (p?.status === 'pago') return pago(p, d.saldo);
          if (!r.ok) return fim(d.erro ?? 'Não achei essa compra.');
          if (p?.status === 'expirado' || p?.status === 'cancelado') return fim('O pagamento não foi concluído e nada foi cobrado. Se quiser, é só tentar de novo.');
        } catch { /* tenta de novo */ }
        if (tentativas >= 15) return fim('Ainda não recebemos a confirmação. Se o pagamento foi aprovado, os Cristais entram sozinhos em alguns minutos.');
        timer = window.setTimeout(olhar, 3000);
      };
      olhar();
    }
    $('[data-copiar]').addEventListener('click', async () => {
      const cc = $<HTMLInputElement>('[data-cc]');
      try { await navigator.clipboard.writeText(cc.value); } catch { cc.select(); document.execCommand('copy'); }
      $('[data-copiar]').textContent = 'Copiado';
    });
    $('[data-cc]').addEventListener('focus', (e) => (e.target as HTMLInputElement).select());
    $('[data-cancelar]').addEventListener('click', async () => {
      if (!atual) return;
      const b = $<HTMLButtonElement>('[data-cancelar]');
      b.disabled = true;
      try {
        const r = await fetch('/api/cristais/cancelar', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: atual.id }) });
        const d = await r.json();
        if (d.status === 'pago') return pago(atual, d.saldo);
        if (d.status === 'cancelado' || d.status === 'expirado') return fim('Pix cancelado. Nada foi cobrado.');
        $('[data-espera]').textContent = d.erro ?? 'Não deu para cancelar agora';
      } catch { /* segue esperando */ } finally { b.disabled = false; }
    });
    // fechar a janela não cancela o Pix: se pagar depois, os Cristais entram do mesmo jeito
    dlg.querySelectorAll('[data-fechar]').forEach((b) => b.addEventListener('click', () => dlg.close()));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', parar);
  }
</script>
