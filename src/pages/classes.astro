---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import ImageSlot from '../components/ImageSlot.astro';
import NextPage from '../components/NextPage.astro';
import { classesMago, trilhaRegras, slugify } from '../data/canon.js';
const nomesNo = ['Nó I', 'Nó II', 'Ápice'];
---
<Base title="Classes de Mago" slug="classes" description="Oito estilos de combate, cada um com Conhecimento de classe, passiva e uma trilha de três ramos onde o mago gasta 4 Pontos de Trilha.">
  <PageHero
    slug="classes"
    title="Classes <em>de Mago</em>"
    lead="A Classe de Mago é o estilo de combate do personagem. Ela vem definida no modelo do /criar-personagem e não muda depois, a não ser por evento."
    intro="Cada classe dá um Conhecimento que não ocupa espaço, uma passiva e uma trilha com três ramos. Com 4 pontos, dois magos da mesma classe podem lutar de jeitos bem diferentes."
    image="classes/capa"
    imageLabel="Os oito estilos de combate"
  />

  <section class="sec" id="trilha">
    <div class="wrap">
      <SectionHead num="01" label="A trilha" title="Quatro pontos, <em>três caminhos</em>." lead="A passiva é a raiz. Cada ramo tem dois nós e um Ápice, e ninguém pega tudo." />
      <dl class="gifts">
        {trilhaRegras.map(([n, t]) => <div data-reveal><dt>{n}</dt><dd>{t}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="sec sec--line">
    <div class="wrap">
      <SectionHead num="02" label="Os oito estilos" title="Como você <em>luta</em>." lead="O Ápice marcado com ★ é o que antes era a Classe Avançada." />
      {classesMago.map((c, i) => (
        <article class="mclass mclass--trilha" id={slugify(c.nome)}>
          <span class="mclass__n">{String(i + 1).padStart(2, '0')}</span>
          <div class="stack" style="--s:1rem">
            <h3 class="t-h2" data-split>{c.nome}</h3>
            <p class="t-lead" data-reveal>{c.papel}</p>
            <div class="chips" data-reveal><span class="chip chip--mana">{c.conhecimento}</span></div>
            <div class="perk" data-reveal><span class="t-label">Raiz · Passiva</span><h4>{c.passiva[0]}</h4><p>{c.passiva[1]}</p></div>
            <div data-reveal><ImageSlot src={`classes/${slugify(c.nome)}`} label={c.nome} ratio="3 / 4" compact /></div>
          </div>
          <div class="ramos">
            {c.trilha.map((r) => (
              <div class="ramo" data-reveal>
                <p class="ramo__nome t-label">{r.ramo}</p>
                <ol class="ramo__nos">
                  {r.nos.map(([n, t], k) => (
                    <li class:list={['no', k === 2 && 'no--apice']}>
                      <span class="no__tag">{nomesNo[k]}{k === 2 ? ' · 3º Estágio' : ''}</span>
                      <h4>{k === 2 && r.estrela ? '★ ' : ''}{n}</h4>
                      <p>{t}</p>
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="sec sec--line sec--raise">
    <div class="wrap grid">
      <div class="c-1-5"><span class="eyebrow" data-reveal><b>03</b>Classe na criação</span></div>
      <div class="c-6-12 stack" style="--s:1rem">
        <p class="t-body" data-reveal>No /criar-personagem a classe é sorteada entre as oito, com mais chance para a que combina com a família. A exceção é a família Frankenstein, que nunca recebe Mago Artífice.</p>
      </div>
    </div>
  </section>

  <NextPage slug="classes" />
</Base>
