---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import GuiaSecoes from '../components/GuiaSecoes.astro';
import { site, familias, classesMago, milagres, magias } from '../data/canon.js';

const totalMagias = magias.reduce((s, m) => s + m.lista.length, 0);
const stats = [
  [familias.length, 'famílias de outras vidas'],
  [classesMago.length, 'Classes de Mago, cada uma com sua árvore'],
  [totalMagias, 'magias com vagas limitadas'],
  [milagres.length, 'Milagres raros'],
];
---
<Base slug="inicio" modo="inicio" aba="inicio">
  <section class="hm-hero">
    <div class="hm-hero__bg"><img src="/img/mundo/valcristal.jpg" alt="" fetchpriority="high" /></div>
    <div class="hm-wrap hm-hero__in">
      <div>
        <p class="hm-hero__kicker px-label"><i></i>RP de texto no Discord · Reino de Diamond</p>
        <h1>Toda alma volta. <em>Nenhuma volta igual.</em></h1>
        <p class="hm-hero__lead">Você viveu em outro reino e morreu lá. Agora acorda em <b>Diamond</b>, o reino que esgotou a própria terra, com um Grimório novo e a memória de quem foi. Sem dados: o que decide a cena é a sua ficha e o que você escreve.</p>
        <div class="hm-hero__cta">
          <a class="px-btn px-btn--ember" href={site.discord} target="_blank" rel="noopener"><Icon name="discord" size={18} />Entrar no servidor</a>
          <a class="px-btn" href="/comecar/">Como criar o personagem<Icon name="seta" size={18} /></a>
        </div>
      </div>
      <aside class="hm-card" aria-label="Como começar">
        <div class="hm-card__h"><b>Acorde em Diamond</b><span class="px-label">3 passos</span></div>
        <ol>
          <li><span><b>Entre no Discord</b>Leia as regras de RP e se apresente.</span></li>
          <li><span><b>Use <code>/criar-personagem</code></b>O bot gera três destinos. Você gira Magia, Conhecimentos e Grimório e escolhe um.</span></li>
          <li><span><b>Conecte a conta aqui</b>Sua ficha, sua árvore e seus Cristais aparecem neste portal.</span></li>
        </ol>
      </aside>
    </div>
  </section>

  <div class="hm-stats">
    {stats.map(([n, t]) => <div><b>{n}</b><span>{t}</span></div>)}
  </div>

  <section class="hm-sec hm-wrap">
    <div class="hm-head">
      <div><span class="px-label">Seu Marcado</span><h2>O personagem do bot, <em>agora no site</em>.</h2></div>
      <p>Entre com a mesma conta do Discord. O portal lê a ficha que o bot guarda, então o que você treina lá aparece aqui.</p>
    </div>
    <div class="hm-doors">
      <a class="hm-door" href="/ficha/">
        <img src="/img/inicio/marcado.jpg" alt="" loading="lazy" />
        <span class="px-label"><Icon name="ficha" size={16} />Ficha</span>
        <h3>Dossiê do Marcado</h3>
        <p>Estágio, Pontos de Estágio, atributos com o teto de cada Estágio, Cristais, Grimório e história.</p>
        <span class="hm-door__go">Abrir a ficha<Icon name="seta" size={18} /></span>
      </a>
      <a class="hm-door" href="/arvores/">
        <img src="/img/classes/mago-arcano.jpg" alt="" loading="lazy" />
        <span class="px-label"><Icon name="arvore" size={16} />Árvores</span>
        <h3>Trilhas de classe</h3>
        <p>Veja a árvore da sua Classe de Mago, planeje os próximos nós e gaste seus Pontos de Trilha.</p>
        <span class="hm-door__go">Ver as árvores<Icon name="seta" size={18} /></span>
      </a>
      <a class="hm-door hm-door--prism" href="/cristais/">
        <img src="/img/mundo/jazida.jpg" alt="" loading="lazy" />
        <span class="px-label"><span class="px-gem"></span>Cristais Prismáticos</span>
        <h3>Loja e Giros</h3>
        <p>A moeda da sua conta. Pacotes, giros e itens de conveniência num lugar só.</p>
        <span class="hm-door__go">Ver os Cristais<Icon name="seta" size={18} /></span>
      </a>
    </div>
  </section>

  <section class="hm-sec hm-wrap" style="padding-top:0">
    <div class="hm-head">
      <div><span class="px-label">Chegou agora?</span><h2>Quatro leituras <em>antes da primeira cena</em>.</h2></div>
    </div>
    <ol class="hm-path">
      <li><h3>Onde você acorda</h3><p>Diamond, a Coroa, o Lapidário, os Veios e o Fosso.</p><a href="/mundo/">O Mundo</a></li>
      <li><h3>Quem a sua alma foi</h3><p>A família da vida passada define classe social, região e heranças.</p><a href="/familias/">Famílias</a></li>
      <li><h3>Como se luta sem dados</h3><p>Compara-se classificação, depois Acréscimos. Nada é rolado.</p><a href="/atributos/">Atributos</a></li>
      <li><h3>Como se cresce</h3><p>Treinos viram Pontos de Estágio, do 9º ao 1º Estágio.</p><a href="/progressao/">Progressão</a></li>
    </ol>
  </section>

  <section class="hm-sec hm-wrap" style="padding-top:0">
    <div class="hm-head">
      <div><span class="px-label">Guia</span><h2>Todos os sistemas, <em>por assunto</em>.</h2></div>
      <p>Cada página abre com um resumo de 30 segundos. Para achar uma regra pelo nome, use a busca (Ctrl K).</p>
    </div>
    <GuiaSecoes />
  </section>
</Base>
