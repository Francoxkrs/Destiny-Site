---
// /ficha · Rolo do Destino: a ficha corre na horizontal como um rolo de papel.
// Um fio vermelho (na cor do jogador) liga a vida passada ao próximo Estágio.
// No celular o rolo vira uma coluna. Os dados vêm do bot (fichasWeb) ou da ficha de exemplo.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Aviso from '../components/portal/Aviso.astro';
import { lerSessao } from '../lib/sessao.js';
import { carregarFicha, imagemUrl } from '../lib/ficha.js';
import { classificacoes, romanos, slugify, estagios, ranks } from '../data/canon.js';
import { arvorePorClasse, migrarIds } from '../data/arvores.js';
import fs from 'node:fs';
import path from 'node:path';
import '../styles/ficha-rolo.css';
export const prerender = false;

const sessao = lerSessao(Astro.cookies);
const { estado, ficha: f, aviso } = await carregarFicha(sessao);
Astro.response.headers.set('cache-control', 'private, no-store');

const fmt = new Intl.NumberFormat('pt-BR');
const exemplo = estado !== 'ok';
const img = imagemUrl(f.imagem) ?? (exemplo ? '/img/ficha/exemplo.png' : null);
const cor = /^#[0-9a-f]{6}$/i.test(f.cor ?? '') ? f.cor : '#ff3b2e';
const brasao = fs.existsSync(path.join(process.cwd(), 'public/img/brasoes', `${slugify(f.familia)}.svg`)) ? `/img/brasoes/${slugify(f.familia)}.svg` : null;
const arvore = arvorePorClasse(f.classeMago);
const trilhaNos = arvore ? migrarIds(arvore, f.trilha.nos).map((id) => arvore.nos.find((n) => n.id === id)).filter(Boolean) : [];

const NAIPE = { Clover: '♣', Spades: '♠', Heart: '♥', Diamond: '◆' };
const naipe = NAIPE[f.origem] ?? '✦';
const KANJI_N = ['', '一', '二', '三', '四', '五', '六', '七', '八', '九'];
const ROM = ['', 'I', 'II', 'III', 'IV'];
const pct = (a, b) => Math.max(0, Math.min(100, b ? (a / b) * 100 : 0));
const magiaCurta = f.magia.replace(/^Magia (de|do|da|dos|das) /, '');

// ---------- Poder: seis traços de caligrafia. Altura = degrau; nada de conta à vista.
const poder = [
  ...f.fisicos.map((a) => ({
    nome: a.nome, k: { 'Força': '力', 'Resistência': '耐', 'Velocidade': '速' }[a.nome] ?? '体',
    rotulo: classificacoes[a.indice]?.nome, h: ((a.indice + 1) / 8) * 100, teto: a.indice >= a.teto && a.indice < 7,
    frase: a.nome === 'Velocidade' ? `Corre a ${classificacoes[a.indice]?.vel} km/h.` : a.nome === 'Força' ? `Quebra ${classificacoes[a.indice]?.forca.toLowerCase()}.` : `Aguenta ${classificacoes[a.indice]?.resistencia.toLowerCase()}.`,
    extra: a.treino.precisa ? `${a.treino.feitos} de ${a.treino.precisa} treinos para ${classificacoes[a.indice + 1]?.nome}.` : a.indice >= a.teto && a.indice < 7 ? 'No teto deste Estágio.' : '',
  })),
  { nome: 'Poder Mágico', k: '魔', rotulo: `${romanos[f.poder - 1]} de VI`, rom: true, h: (f.poder / 6) * 100, frase: 'O peso de cada feitiço que você lança.' },
  { nome: 'Reserva Mágica', k: '源', rotulo: `${romanos[f.reserva - 1]} de X`, rom: true, h: (f.reserva / 10) * 100, frase: `${fmt.format(f.mana.max)} de Mana no tanque.` },
  { nome: 'Controle', k: '御', rotulo: `${f.controle}%`, h: Math.max(4, f.controle), frase: 'Mais Controle, feitiço mais barato.' },
];

// ---------- Caminho: os 9 Estágios, com o atual e o próximo em destaque
const prox = f.proximo;
const reqs = prox ? [
  { nome: 'PE', tem: f.pe, precisa: prox.pe },
  prox.controle ? { nome: 'Controle', tem: f.controle, precisa: prox.controle, un: '%' } : null,
  prox.cristais.branco ? { nome: 'Brancos', tem: f.moedas.cristais.branco, precisa: prox.cristais.branco } : null,
  prox.cristais.negro ? { nome: 'Negros', tem: f.moedas.cristais.negro, precisa: prox.cristais.negro } : null,
  prox.cristais.dourado ? { nome: 'Dourados', tem: f.moedas.cristais.dourado, precisa: prox.cristais.dourado } : null,
].filter(Boolean) : [];
const pronto = prox && reqs.every((r) => r.tem >= r.precisa);
const caminho = estagios.map((e) => {
  const n = parseInt(e.n, 10);
  const st = n > f.estagio ? 'foi' : n === f.estagio ? 'agora' : prox && n === prox.estagio ? 'prox' : 'vem';
  return { n, k: KANJI_N[n], ganho: e.ganhos.split(';')[0], req: e.req, st };
});
// como chegar lá: só o que falta de verdade
const caminhos = [];
for (const a of f.fisicos) if (a.treino.precisa && a.indice < a.teto) caminhos.push({ t: `Treino de ${a.nome}`, d: `${a.treino.feitos} de ${a.treino.precisa} para ${classificacoes[a.indice + 1]?.nome}. Subir dá 1 PE.`, href: '/atributos/' });
if (prox?.controle && f.controle < prox.controle) caminhos.push({ t: 'Treino de Controle', d: '+1% por treino. A cada 10%, 1 PE.', href: '/mana/' });
const rankCristal = ranks.filter((r) => r.cristais && r.cristais !== '—');
if (prox && prox.cristais.branco > f.moedas.cristais.branco) caminhos.push({ t: 'Missões de Rank C ou B', d: rankCristal.filter((r) => /Branco/.test(r.cristais)).map((r) => `Rank ${r.r}: ${r.cristais}`).join(' · '), href: '/missoes/' });
if (prox && prox.cristais.negro > f.moedas.cristais.negro) caminhos.push({ t: 'Missões de Rank A', d: 'Cada Rank A paga 1 Cristal Negro.', href: '/missoes/' });

const fer = f.ferimentos ?? { pior: 0, desnutrido: false, casas: [1, 1, 1, 2, 2, 3, 4].map((grau) => ({ grau, ocupada: false })) };
const ferTxt = fer.pior ? `${['', 'I Leve', 'II Moderado', 'III Grave', 'IV Crítico'][fer.pior]}${fer.desnutrido ? ' · Desnutrido' : ''}` : 'Ileso';
const brancas = f.feiticosTotal ? Math.max(0, f.feiticosTotal - f.feiticos.length) : 0;
const TIPO_K = { Ataque: '攻', Defesa: '守', Suporte: '援', Cura: '癒', Controle: '縛', Movimento: '駆' };
const usaAnti = f.moedas.antimeritos > f.moedas.meritos;
const semTexto = 'Ainda não escrita. Escreva na aba Pessoal da /ficha no Discord.';
---
<Base title="Ficha" slug="ficha" aba="ficha" description="A ficha do seu Marcado como um rolo: vida passada, quem é hoje, Poder, Grimório e o caminho até o próximo Estágio.">
  <div class="rl" style={`--c:${cor}`} data-rl>
    <script is:inline>if (innerWidth > 860) document.currentScript.parentElement.classList.add('is-h');</script>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="rl-selo" x="-10%" y="-10%" width="120%" height="120%"><feTurbulence type="fractalNoise" baseFrequency=".06" numOctaves="3" seed="7" /><feDisplacementMap in="SourceGraphic" scale="9" /></filter>
      <filter id="rl-pincel" x="-10%" y="-5%" width="120%" height="110%"><feTurbulence type="fractalNoise" baseFrequency=".5 .03" numOctaves="2" seed="5" /><feDisplacementMap in="SourceGraphic" scale="8" /></filter>
      <filter id="rl-fio"><feTurbulence type="fractalNoise" baseFrequency=".02" numOctaves="2" seed="1" /><feDisplacementMap in="SourceGraphic" scale="4" /></filter>
    </svg>

    <div class="rl-rolo" data-rolo>
      <div class="rl-vista">
        <div class="rl-trilho" data-trilho>
          <div class="rl-papel" aria-hidden="true"></div>
          <svg class="rl-fio" data-fio aria-hidden="true"><path class="rl-fio__base" data-base /><path data-linha /></svg>

          <!-- abertura -->
          <section class="rl-q rl-q0" data-cap="巻" aria-label="Abertura">
            <div class="rl-aviso"><Aviso estado={exemplo ? estado : null} aviso={aviso} logado={Boolean(sessao)} /></div>
            <div class="rl-hanko" data-r aria-hidden="true">黒<br />運</div>
            <p class="rl-mono" data-r>{f.numero ? `Ficha nº ${String(f.numero).padStart(4, '0')} · Marcado` : 'Prévia · aguardando o Conselho Mágico'}</p>
            <h1 class="rl-tit" data-r>O Rolo de <em>{f.nome}</em></h1>
            <p class="rl-txt" data-r>Siga o fio vermelho. Ele começa onde {f.nome} morreu e termina no próximo Estágio.</p>
            <p class="rl-dica rl-mono" data-r><span></span>Role para desenrolar</p>
          </section>

          <!-- I · vida passada -->
          <section class="rl-q rl-q1" data-cap="前" aria-labelledby="rl-t1">
            <p class="rl-cap rl-mono"><i>前世</i>I · Vida passada</p>
            <span class="rl-kv" aria-hidden="true">死</span>
            <div class="rl-naipe" data-r aria-hidden="true">{naipe}</div>
            <h2 id="rl-t1" data-r>Morreu em {f.origem ?? 'outra terra'}</h2>
            <p class="rl-txt" data-r>{f.historia.vidaPassada || semTexto}</p>
            {brasao && <p class="rl-fam" data-r><img src={brasao} alt="" />{f.familia}</p>}
          </section>

          <!-- II · despertar -->
          <section class="rl-q rl-q2" data-cap="覚" aria-labelledby="rl-t2">
            <p class="rl-cap rl-mono"><i>覚醒</i>II · O despertar</p>
            <h2 id="rl-t2" data-r>Acordou em Diamond</h2>
            <p class="rl-txt" data-r>{f.historia.renascimento || semTexto}</p>
            <div class="rl-magia" data-r>
              <b aria-hidden="true">{magiaCurta.slice(0, 1)}</b>
              <div>
                <small>Grimório {f.grimorio}{f.magiaRaridade && ` · ${f.magiaRaridade}`}</small>
                <strong>{f.magia}</strong>
                <small>{f.milagres.length ? `${f.milagres.length > 1 ? 'Milagres' : 'Milagre'}: ${f.milagres.join(' · ')}` : 'Sem Milagre ainda'}</small>
              </div>
            </div>
          </section>

          <!-- III · hoje -->
          <section class="rl-q rl-q3" data-cap="今" aria-labelledby="rl-t3">
            <p class="rl-cap rl-mono"><i>今</i>III · Quem é hoje</p>
            <figure class="rl-fig" data-fig>
              <span class="rl-sol" aria-hidden="true"></span>
              {img ? <img src={img} alt={`Imagem de ${f.nome}`} /> : <span class="rl-sem">Sem imagem</span>}
              <div class="rl-chip" aria-label={`${f.estagio}º Estágio`}><b>{KANJI_N[f.estagio]}</b><span>ESTÁGIO</span></div>
            </figure>
            <div class="rl-quem">
              <h2 id="rl-t3" class="rl-nome" data-r>{f.nome}</h2>
              {f.sobrenome && <p class="rl-sob" data-r>{f.sobrenome}</p>}
              {f.epiteto && <p class="rl-ep" data-r>{f.epiteto}</p>}
              <dl class="rl-dl" data-r>
                <dt>Classe</dt><dd>{f.classeMago}</dd>
                <dt>Raça</dt><dd>{f.racasHibrido ? `Híbrido · ${f.racasHibrido.join(' e ')}` : f.raca}</dd>
                <dt>Família</dt><dd>{f.familia} · {naipe} {f.origem}</dd>
                <dt>Classe social</dt><dd>{f.classeSocial} · {f.regiao}</dd>
                <dt>Patente</dt><dd>{f.patente ?? 'Sem patente'}</dd>
                <dt>Profissão</dt><dd>{f.profissao ?? 'Nenhuma ainda'}</dd>
              </dl>
              {f.historia.personalidade && <p class="rl-txt rl-pers" data-r>{f.historia.personalidade}</p>}
            </div>
          </section>

          <!-- IV · poder -->
          <section class="rl-q rl-q4" data-cap="力" aria-labelledby="rl-t4">
            <p class="rl-cap rl-mono"><i>力</i>IV · Poder</p>
            <h2 id="rl-t4" data-r>Até onde {f.nome} chega</h2>
            <div class="rl-cols">
              {poder.map((a, i) => (
                <div class:list={['rl-col', a.teto && 'is-teto']} tabindex="0" style={`--i:${i}`}>
                  <span class="rl-frase">{a.frase}{a.extra && <><br /><em>{a.extra}</em></>}</span>
                  <div class="rl-haste" style={`--h:${a.h}%`}>
                    <div class="rl-traco"></div>
                    <span class:list={['rl-vert', a.rom && 'is-rom']}>{a.rotulo}</span>
                    {a.teto && <span class="rl-marco"></span>}
                  </div>
                  <i aria-hidden="true">{a.k}</i>
                  <span class="rl-mono">{a.nome}</span>
                </div>
              ))}
            </div>
            <p class="rl-leg" data-r>Cada traço é um degrau. A linha vermelha é o teto do {f.estagio}º Estágio. Passe o mouse (ou toque) para ler.</p>
          </section>

          <!-- V · grimório -->
          <section class="rl-q rl-q5" data-cap="書" aria-labelledby="rl-t5">
            <p class="rl-cap rl-mono"><i>書</i>V · Grimório</p>
            <h2 id="rl-t5" data-r>{f.feiticosTotal ? `${f.feiticos.length} de ${f.feiticosTotal} páginas escritas` : `${f.feiticos.length} ${f.feiticos.length === 1 ? 'página escrita' : 'páginas escritas'}`}</h2>
            <div class="rl-tiras">
              {f.feiticos.map((x) => {
                const fi = imagemUrl(x.imagem);
                return (
                  <article class="rl-tira">
                    <div class="rl-tira__k">{fi ? <img src={fi} alt="" loading="lazy" /> : <span aria-hidden="true">{TIPO_K[x.tipo] ?? '術'}</span>}</div>
                    <h3>{x.nome}</h3>
                    <span class="rl-mono">{[x.tipo, x.estagio ? `${x.estagio}º Estágio` : null].filter(Boolean).join(' · ')}</span>
                  </article>
                );
              })}
              {Array.from({ length: Math.min(brancas, 3) }, () => <article class="rl-tira is-branca"><b>Página em branco</b><span class="rl-mono">ainda não escrita</span></article>)}
            </div>
          </section>

          <!-- VI · corpo e saber -->
          <section class="rl-q rl-q6" data-cap="体" aria-labelledby="rl-t6">
            <p class="rl-cap rl-mono"><i>体</i>VI · Corpo e saber</p>
            <h2 id="rl-t6" class="rl-vh">Corpo e saber</h2>
            <div class="rl-duas">
              <div data-r>
                <p class="rl-h5">Mana</p>
                <p class="rl-grande">{fmt.format(f.mana.atual)} <span>de {fmt.format(f.mana.max)}</span></p>
                <div class="rl-mana" style={`--p:${pct(f.mana.atual, f.mana.max)}%`}></div>
                <p class="rl-h5">Ferimentos · {ferTxt}</p>
                <ol class="rl-fer">{fer.casas.map((c, i) => <li class:list={[c.ocupada && 'is-on', c.fome && 'is-fome', i > 0 && fer.casas[i - 1].grau !== c.grau && 'is-grupo']}>{ROM[c.grau]}</li>)}</ol>
                <p class="rl-nota">Encheu uma faixa, o ferimento sobe de Grau.</p>
                <p class="rl-h5">Trilha · {f.trilha.livres} {f.trilha.livres === 1 ? 'ponto livre' : 'pontos livres'}</p>
                <ul class="rl-lista">{trilhaNos.length ? trilhaNos.map((n) => <li>{n.nome}</li>) : <li class="is-vaga">Nenhuma habilidade ainda</li>}</ul>
                <a class="rl-link" href="/arvores/">Abrir a árvore <Icon name="seta" size={13} /></a>
              </div>
              <div data-r>
                <p class="rl-h5">Conhecimentos · {f.conhecimentos.length} de 6</p>
                <ul class="rl-lista">{f.conhecimentos.map((c) => <li>{c}</li>)}{f.conhecimentos.length < 6 && <li class="is-vaga">vaga</li>}</ul>
                <p class="rl-h5">Traços · {f.tracos.length} de 3</p>
                <ul class="rl-lista">{f.tracos.map((c) => <li>{c}</li>)}{f.tracos.length < 3 && <li class="is-vaga">vaga</li>}</ul>
                <p class="rl-h5">Técnicas de Mana</p>
                <ul class="rl-lista">{f.tecnicas.length ? f.tecnicas.map((c) => <li>{c}</li>) : <li class="is-vaga">Nenhuma ainda</li>}</ul>
                {f.treinosLivres && <p class="rl-nota">Treinos livres da semana · Físico {f.treinosLivres.fisico.join(' de ')} · Mágico {f.treinosLivres.magico.join(' de ')} · Controle {f.treinosLivres.controle.join(' de ')} · Técnica {f.treinosLivres.tecnica.join(' de ')}</p>}
              </div>
            </div>
          </section>

          <!-- VII · caminho -->
          <section class="rl-q rl-q7" data-cap="道" aria-labelledby="rl-t7">
            <p class="rl-cap rl-mono"><i>道</i>VII · O caminho</p>
            <h2 id="rl-t7" data-r>{pronto ? <>Pronto para o {prox.estagio}º Estágio</> : 'Do 9º ao 1º Estágio'}</h2>
            <ol class="rl-caminho">
              {caminho.map((e) => (
                <li class:list={['rl-est', `is-${e.st}`]}>
                  {e.st === 'agora' && <span class="rl-raios" aria-hidden="true"></span>}
                  <div class="rl-selo" aria-hidden="true">{e.k}{e.st === 'agora' && <span class="rl-voce">VOCÊ ESTÁ AQUI</span>}</div>
                  <div>
                    <b>{e.n}º Estágio</b>
                    <small>{e.ganho}</small>
                    {e.st === 'prox' ? (
                      <div class="rl-pr">{reqs.map((r) => <span class:list={[r.tem >= r.precisa && 'is-ok']}>{r.nome} {r.tem}{r.un ?? ''}/{r.precisa}{r.un ?? ''}<i style={`--p:${pct(r.tem, r.precisa)}%`}></i></span>)}</div>
                    ) : e.st === 'vem' ? <span class="rl-req">{e.req}</span> : null}
                  </div>
                </li>
              ))}
            </ol>
            {caminhos.length > 0 && (
              <ul class="rl-como" data-r>
                {caminhos.slice(0, 3).map((c) => <li><a href={c.href}><b>{c.t}</b><small>{c.d}</small></a></li>)}
              </ul>
            )}
          </section>

          <!-- fim -->
          <section class="rl-q rl-q8" data-cap="続" aria-labelledby="rl-t8">
            <div class="rl-cont" data-r aria-hidden="true">続</div>
            <h2 id="rl-t8" data-r>Continua na próxima missão</h2>
            <div class="rl-bolsa" data-r>
              <span><b class="is-c">{usaAnti ? f.moedas.antimeritos : f.moedas.meritos}</b>{usaAnti ? 'Antiméritos' : 'Méritos'}</span>
              <span><b class="is-ouro">{fmt.format(f.moedas.yuls)}</b>Yuls</span>
              <span><b class="is-gema">{f.moedas.cristais.branco}·{f.moedas.cristais.negro}·{f.moedas.cristais.dourado}</b>Cristais B·N·D</span>
            </div>
            <a class="rl-link" href="/missoes/" data-r>Ver missões <Icon name="seta" size={13} /></a>
          </section>
        </div>
      </div>
    </div>

    <nav class="rl-regua" aria-label="Capítulos da ficha" data-regua><span class="rl-regua__barra" data-barra></span></nav>
  </div>
</Base>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-rl]');
  if (raiz) {
    const rolo = raiz.querySelector<HTMLElement>('[data-rolo]')!;
    const trilho = raiz.querySelector<HTMLElement>('[data-trilho]')!;
    const secs = Array.from(trilho.querySelectorAll<HTMLElement>('.rl-q'));
    const regua = raiz.querySelector<HTMLElement>('[data-regua]')!;
    const barra = raiz.querySelector<HTMLElement>('[data-barra]')!;
    const fio = raiz.querySelector<SVGSVGElement>('[data-fio]')!;
    const linha = raiz.querySelector<SVGPathElement>('[data-linha]')!;
    const base = raiz.querySelector<SVGPathElement>('[data-base]')!;
    const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;

    secs.forEach((s, i) => {
      const b = document.createElement('button');
      b.type = 'button'; b.textContent = s.dataset.cap ?? '·';
      b.setAttribute('aria-label', s.getAttribute('aria-label') ?? s.querySelector('h1, h2')?.textContent ?? `Capítulo ${i + 1}`);
      b.addEventListener('click', () => ir(i));
      regua.appendChild(b);
    });
    const botoes = Array.from(regua.querySelectorAll('button'));

    let horizontal = false, distancia = 0, comp = 1, topo = 0;
    const medir = () => {
      horizontal = innerWidth > 860;
      raiz.classList.toggle('is-h', horizontal);
      trilho.style.transform = '';
      const W = trilho.scrollWidth, H = trilho.offsetHeight;
      distancia = Math.max(0, W - innerWidth);
      rolo.style.height = horizontal ? `${distancia + innerHeight}px` : '';
      topo = rolo.getBoundingClientRect().top + scrollY;
      fio.setAttribute('viewBox', `0 0 ${W} ${H}`); fio.style.width = `${W}px`;
      let d = `M 0 ${H * 0.9}`, x = 0;
      secs.forEach((s, i) => {
        const w = s.offsetWidth, y = H * (i % 2 ? 0.95 : 0.86);
        d += ` C ${x + w * 0.35} ${y - 70}, ${x + w * 0.65} ${y + 60}, ${x + w} ${H * (i % 2 ? 0.88 : 0.93)}`;
        x += w;
      });
      linha.setAttribute('d', d); base.setAttribute('d', d);
      comp = linha.getTotalLength(); linha.style.strokeDasharray = String(comp);
      rodar();
    };
    const ir = (i: number) => {
      const y = horizontal ? topo + Math.min(secs[i].offsetLeft, distancia) : secs[i].getBoundingClientRect().top + scrollY - 80;
      const l = (window as any).__lenis;
      if (l) l.scrollTo(y, { duration: reduz ? 0 : 1.2 }); else scrollTo({ top: y, behavior: reduz ? 'auto' : 'smooth' });
    };
    const rodar = () => {
      const p = horizontal && distancia ? Math.min(1, Math.max(0, (scrollY - topo) / distancia)) : 0;
      const x = p * distancia;
      if (horizontal) trilho.style.transform = `translate3d(${-x}px,0,0)`;
      linha.style.strokeDashoffset = String(comp * (1 - Math.min(1, (x + innerWidth * 0.7) / trilho.scrollWidth)));
      barra.style.setProperty('--p', String(p));
      let atual = 0;
      secs.forEach((s, i) => {
        const r = s.getBoundingClientRect();
        if (r.left < innerWidth * 0.8 && r.right > innerWidth * 0.1 && r.top < innerHeight * 0.85) s.classList.add('is-visto');
        if (horizontal ? r.left <= innerWidth * 0.45 : r.top <= innerHeight * 0.45) atual = i;
      });
      botoes.forEach((b, i) => b.classList.toggle('is-on', i === atual));
    };
    let pedido = 0;
    addEventListener('scroll', () => { cancelAnimationFrame(pedido); pedido = requestAnimationFrame(rodar); }, { passive: true });
    addEventListener('resize', medir);
    document.fonts.ready.then(medir);
    raiz.querySelectorAll('img').forEach((im) => im.complete || im.addEventListener('load', medir, { once: true }));
    medir();
  }
</script>
